---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import BannerTracker from "../../components/bannerComponents/BannerTracker.astro";
import { bannersData } from "../../data/banners";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const bannerCanonicalUrl = new URL("/banners", Astro.site).href;
---

<Layout
  title={t.banner.title}
  description={t.banner.subtitle}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: t.banner.title,
      description: t.banner.subtitle,
      url: bannerCanonicalUrl,
      mainEntity: bannersData.flatMap((game) =>
        game.banners.map((banner) => ({
          "@type": "Event",
          name: banner.title,
          description: `${banner.title} - ${game.gameTitle} banner`,
          startDate: banner.startDate,
          endDate: banner.endDate,
          image: banner.image,
          eventStatus: banner.startDate <= new Date().toISOString() && banner.endDate >= new Date().toISOString()
            ? "https://schema.org/EventScheduled"
            : banner.endDate < new Date().toISOString()
            ? "https://schema.org/EventEnded"
            : "https://schema.org/EventScheduled",
        }))
      ),
    })}
  />
  <main
    id="main-content"
    class="flex-1 w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-14"
  >
    <BannerTracker games={bannersData} />
  </main>
</Layout>
