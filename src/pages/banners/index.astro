---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import BannerTracker from "../../components/bannerComponents/BannerTracker.astro";
import { bannersData } from "../../data/banners";
import { buildBannersJsonLd } from "../../utils/banner-schema";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const bannerCanonicalUrl = new URL("/banners/", Astro.site).href;
const bannersJsonLd = buildBannersJsonLd(bannersData, {
  title: t.banner.title,
  description: t.banner.subtitle,
  url: bannerCanonicalUrl,
  lang: lang === "es" ? "es" : "en",
  site: Astro.site ?? Astro.url,
});
---

<Layout
  title={t.banner.title}
  description={t.banner.subtitle}
  url={bannerCanonicalUrl}
  canonical={bannerCanonicalUrl}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(bannersJsonLd)}
  />
  <main
    id="main-content"
    class="flex-1 w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-14"
  >
    <BannerTracker games={bannersData} />
  </main>
</Layout>
