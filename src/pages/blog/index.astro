---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/blogComponents/BlogCard.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = (
  await getCollection("blog", ({ id }) => !id.startsWith("es/"))
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const canonicalUrl = new URL("/blog", Astro.site).href;
const pageTitle = "Gacha Game Guides, Patch Cycles & Update Schedules";
const pageDescription =
  "In-depth articles about gacha game version cycles, patch schedules, update timers, and what to expect with every release.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  url={canonicalUrl}
  canonical={canonicalUrl}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      name: "Gacha Countdown Blog",
      description: pageDescription,
      url: canonicalUrl,
      publisher: {
        "@type": "Organization",
        name: "Gacha Countdown Team",
      },
      blogPost: posts.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        datePublished: post.data.publishDate,
        dateModified: post.data.updatedDate ?? post.data.publishDate,
        url: new URL(`/blog/${post.id.replace(/^en\//, "")}`, Astro.site).href,
      })),
    })}
  />
  <main
    id="main-content"
    class="grow max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 w-full"
  >
    <div class="mb-6 sm:mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold mb-2">{pageTitle}</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base">
        {pageDescription}
      </p>
    </div>

    {
      posts.length > 0 ? (
        <div class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <div class="glass-panel rounded-2xl p-8 sm:p-12 text-center">
          <p class="font-display font-bold text-white text-lg sm:text-xl mb-2">
            New articles coming soon
          </p>
          <p class="text-slate-400 text-sm">
            We are writing in-depth guides about version cycles and patch
            schedules. Check back soon.
          </p>
        </div>
      )
    }
  </main>
</Layout>
