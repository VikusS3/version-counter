---
import Layout from "../../../layouts/Layout.astro";
import { Counter } from "../../../components/react/Counter";
import { CopyButton } from "../../../components/react/CopyButton";
import BannerAlert from "../../../components/bannerComponents/BannerAlert.astro";
import { useTranslations } from "../../../i18n/utils";
import { getLocalizedGame } from "../../../data/translations/getGameData";

const t = useTranslations("es");
const game = getLocalizedGame("honkai-star-rail", "es");

const nextVersionDate = new Date(
  Date.parse(game?.fecha_inicio ?? "") +
    (game?.duracion_dias ?? 42) * 24 * 60 * 60 * 1000
);
const nextVersionDateText = nextVersionDate.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const faqItems = [
  {
    question: `¿Cuándo sale la versión ${game?.proxima_version} de Honkai Star Rail?`,
    answer: `Se espera que la actualización ${game?.proxima_version} de Honkai Star Rail salga alrededor del ${nextVersionDateText}, siguiendo el ciclo de parches estándar de ${game?.duracion_dias} días. La hora exacta de lanzamiento se muestra en la cuenta regresiva en vivo.`,
  },
  {
    question: "¿En qué versión está Honkai Star Rail ahora mismo?",
    answer: `Honkai Star Rail se encuentra actualmente en la versión ${game?.version_actual}, y la próxima actualización importante es la versión ${game?.proxima_version}.`,
  },
  {
    question: `¿Dónde puedo ver las notas del parche oficiales de Honkai Star Rail ${game?.version_actual}?`,
    answer:
      'Puedes leer las notas del parche oficiales de Honkai Star Rail en Hoyolab, enlazadas desde el botón "Ver Notas del Parche" de esta página.',
  },
  {
    question: "¿Cuáles son los horarios de mantenimiento de los servidores de Honkai Star Rail?",
    answer:
      "El mantenimiento de Honkai Star Rail suele comenzar unas horas antes del lanzamiento de la versión. La cuenta regresiva de esta página rastrea la hora exacta de actualización para los servidores de América, Europa y Asia.",
  },
];

const gameCanonicalUrl = new URL("/es/games/hsr", Astro.site).href;
const gameImage = new URL(game?.imagen ?? "/og-image.webp", Astro.site).href;

const gameKeywords = `
  cuenta regresiva honkai star rail,
  honkai star rail ${game?.proxima_version},
  cuando sale honkai star rail ${game?.proxima_version},
  proxima actualizacion honkai star rail,
  fecha de lanzamiento honkai star rail ${game?.proxima_version},
  hora del mantenimiento honkai star rail,
  banners honkai star rail ${game?.version_actual},
  personajes honkai star rail ${game?.version_actual},
  notas del parche honkai star rail,
  proximas versiones honkai star rail,
  cuenta regresiva servidor america honkai star rail,
  honkai star rail version ${game?.version_actual}
`;
---

<Layout
  title={`Cuenta Regresiva Honkai Star Rail ${game?.proxima_version} - Banners y Notas del Parche`}
  description={`Cuenta regresiva para el lanzamiento de Honkai Star Rail ${game?.proxima_version} en servidores de América, Europa y Asia. Sigue la hora de la actualización, los banners, el mantenimiento y las notas del parche oficiales.`}
  keywords={gameKeywords}
  image={gameImage}
  lang="es"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoGame",
      "@id": gameCanonicalUrl,
      name: `Honkai Star Rail v${game?.version_actual}`,
      alternatename: `Honkai Star Rail ${game?.proxima_version}`,
      description: game?.descripcion,
      url: gameCanonicalUrl,
      image: gameImage,
      genre: "Space Fantasy RPG",
      applicationCategory: "GameApplication",
      operatingSystem: "iOS, Android, PC, PS5",
      publisher: {
        "@type": "Organization",
        name: "HoYoverse",
        url: "https://www.hoyoverse.com",
      },
      version: game?.version_actual,
      datePublished: game?.fecha_inicio,
      applicationDate: game?.fecha_inicio,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": gameCanonicalUrl,
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: gameCanonicalUrl,
      },
      inLanguage: "es",
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    })}
  />
  <div
    class="fixed inset-0 z-0 opacity-30 pointer-events-none bg-cover bg-center"
    role="img"
    aria-label="Honkai Star Rail versión {game?.version_actual}"
    style=`background-image:url(${game?.imagen});`
  >
  </div>
  <main id="main-content" class="flex-1 flex flex-col items-center">
    <section class="w-full max-w-300 px-4 sm:px-6 pt-8 sm:pt-12 mb-12 sm:mb-16">
      <div class="@container">
        <div
          class="flex flex-col items-center justify-center text-center mb-6 sm:mb-8"
        >
          <div
            class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1 rounded-full bg-primary/50 border border-primary/40 text-white text-[11px] sm:text-sm font-bold tracking-widest uppercase mb-3 sm:mb-4"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
              ></span>
            </span>
            {t.gamePage.countdownToVersion}
            {game?.proxima_version}
          </div>
          <h1
            class="text-white text-3xl sm:text-4xl md:text-6xl font-black leading-tight tracking-tight mb-3 sm:mb-4"
          >
            {game?.nombre_version_actual}
            <span class="text-gold italic font-serif">{game?.slogan_name}</span>
          </h1>
          <p class="text-slate-400 text-sm sm:text-base md:text-lg max-w-2xl">
            {game?.slogan_desc}
          </p>
        </div>
        <!-- Collab Event Countdown -->
        <!-- <div class="mt-8 sm:mt-10 w-full max-w-xs mx-auto">
          <div
            class="relative glass-panel rounded-2xl p-4 sm:p-5 border border-purple-500/25 shadow-[0_0_20px_-8px_var(--color-hsr-purple)]"
          >
            <div
              class="absolute top-0 left-4 right-4 h-px bg-gradient-to-r from-transparent via-purple-500/60 to-transparent"
            >
            </div>
            <div class="flex items-center justify-center gap-1.5 mb-2.5">
              <span class="relative flex h-2 w-2">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2 w-2 bg-purple-400"
                ></span>
              </span>
              <span
                class="text-[10px] font-bold tracking-widest uppercase text-purple-300"
                >{t.event.limited}</span
              >
            </div>
            <h3 class="text-white text-sm font-bold text-center mb-2">
              {t.event.name}
            </h3>
            <div
              class="w-8 h-px bg-linear-to-r from-transparent via-amber-400/50 to-transparent mx-auto mb-2.5"
            >
            </div>
            <p
              class="text-[9px] uppercase tracking-[0.2em] font-semibold text-center text-amber-400/80 mb-2.5"
            >
              {t.event.startsIn}
            </p>
            <ReleaseCounter
              client:only="react"
              fecha_salida="2026-07-24T12:00:00Z"
              variant="mini"
              labels={{
                days: t.counter.days,
                hours: t.counter.hours,
                minutes: t.counter.minutes,
                seconds: t.counter.seconds,
                finished: t.event.liveNow,
              }}
            />
          </div>
        </div> -->
        <div>
          <Counter
            client:only="react"
            fecha_inicio={game?.fecha_inicio}
            duracion_dias={game?.duracion_dias}
            variant="full"
            labels={{
              days: t.counter.days,
              hours: t.counter.hours,
              minutes: t.counter.minutesFull,
              seconds: t.counter.secondsFull,
              finished: t.counter.finished,
            }}
          />
        </div>
        <div class="mt-6 sm:mt-8">
          <BannerAlert
            game="honkai-star-rail"
            color="var(--color-hsr-purple)"
          />
        </div>
        <div
          class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4 mt-3 sm:mt-4"
        >
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={game?.patch_notes}
            title="Notas del parche oficiales de Honkai Star Rail en Hoyolab"
            class="flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 sm:px-8 py-3 min-h-[48px] rounded-xl font-bold transition-all transform hover:scale-105"
          >
            <span class="material-symbols-outlined" aria-hidden="true"
              >menu_book</span
            >
            {t.gamePage.viewPatchNotes}
          </a>
          <CopyButton
            client:only="react"
            label={t.gamePage.remindMe}
            successMessage={t.gamePage.toastSuccess}
            errorMessage={t.gamePage.toastError}
          />
        </div>
      </div>
    </section>

    <!-- FAQ / SEO section -->
    <section class="w-full max-w-300 px-4 sm:px-6 pb-12 sm:pb-16">
      <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-white/10">
        <h2 class="text-white text-2xl sm:text-3xl font-bold mb-6 text-center">
          Preguntas Frecuentes Honkai Star Rail {game?.proxima_version}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            faqItems.map((item) => (
              <details class="group rounded-xl bg-white/5 border border-white/10 p-4 sm:p-5">
                <summary
                  class="cursor-pointer list-none flex items-center justify-between gap-3 font-semibold text-white text-sm sm:text-base"
                >
                  {item.question}
                  <span
                    class="shrink-0 text-gold transition-transform group-open:rotate-45"
                    aria-hidden="true"
                  >+</span>
                </summary>
                <p class="mt-3 text-slate-300 text-sm leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
        <div class="mt-8 text-center">
          <a
            href="/es/banners"
            class="inline-flex items-center gap-2 text-blue-300 hover:text-blue-200 font-semibold text-sm sm:text-base"
          >
            {t.banner.viewBanners}
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>