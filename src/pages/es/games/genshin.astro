---
import Layout from "../../../layouts/Layout.astro";
import { Counter } from "../../../components/react/Counter";
import { CopyButton } from "../../../components/react/CopyButton";
import BannerAlert from "../../../components/bannerComponents/BannerAlert.astro";
import GachaSalesBanner from "../../../components/bannerComponents/GachaSalesBanner.astro";
import { useTranslations } from "../../../i18n/utils";
import { getLocalizedGame } from "../../../data/translations/getGameData";

const t = useTranslations("es");
const game = getLocalizedGame("genshin-impact", "es");

const nextVersionDate = new Date(
  Date.parse(game?.fecha_inicio ?? "") +
    (game?.duracion_dias ?? 42) * 24 * 60 * 60 * 1000
);
const nextVersionDateText = nextVersionDate.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const faqItems = [
  {
    question: `¿Cuándo sale la versión ${game?.proxima_version} de Genshin Impact?`,
    answer: `Se espera que la actualización ${game?.proxima_version} de Genshin Impact salga alrededor del ${nextVersionDateText}, siguiendo el ciclo de parches estándar de 42 días. La hora exacta de lanzamiento se muestra en la cuenta regresiva en vivo.`,
  },
  {
    question: "¿En qué versión está Genshin Impact ahora mismo?",
    answer: `Genshin Impact se encuentra actualmente en la versión ${game?.version_actual}, y la próxima actualización importante es la versión ${game?.proxima_version}.`,
  },
  {
    question: `¿Dónde puedo ver las notas del parche oficiales de Genshin Impact ${game?.version_actual}?`,
    answer:
      'Puedes leer las notas del parche oficiales de Genshin Impact en Hoyolab, enlazadas desde el botón "Ver Notas del Parche" de esta página.',
  },
  {
    question: "¿Cuáles son los horarios de mantenimiento de los servidores de Genshin Impact?",
    answer:
      "El mantenimiento de Genshin Impact suele comenzar unas horas antes del lanzamiento de la versión. La cuenta regresiva de esta página rastrea la hora exacta de actualización para los servidores de América, Europa y Asia.",
  },
];

const gameCanonicalUrl = new URL("/es/games/genshin", Astro.site).href;
const gameImage = new URL(game?.imagen ?? "/og-image.webp", Astro.site).href;

const gameKeywords = `
  cuenta regresiva genshin impact,
  genshin impact ${game?.proxima_version},
  cuando sale genshin impact ${game?.proxima_version},
  proxima actualizacion genshin impact,
  fecha de lanzamiento genshin impact ${game?.proxima_version},
  hora del mantenimiento genshin impact,
  banners genshin impact ${game?.version_actual},
  personajes genshin impact ${game?.version_actual},
  notas del parche genshin impact,
  proximas versiones genshin impact,
  cuenta regresiva servidor america genshin impact,
  genshin impact version ${game?.version_actual}
`;
---

<Layout
  title={`Cuenta Regresiva Genshin Impact ${game?.proxima_version} - Banners y Notas del Parche`}
  description={`Cuenta regresiva para el lanzamiento de Genshin Impact ${game?.proxima_version} en servidores de América, Europa y Asia. Sigue la hora de la actualización, los banners, el mantenimiento y las notas del parche oficiales.`}
  keywords={gameKeywords}
  image={gameImage}
  lang="es"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoGame",
      "@id": gameCanonicalUrl,
      name: `Genshin Impact v${game?.version_actual}`,
      alternatename: `Genshin Impact ${game?.proxima_version}`,
      description: game?.descripcion,
      url: gameCanonicalUrl,
      image: gameImage,
      genre: "Action RPG",
      applicationCategory: "GameApplication",
      operatingSystem: "iOS, Android, PC, PS5",
      publisher: {
        "@type": "Organization",
        name: "HoYoverse",
        url: "https://www.hoyoverse.com",
      },
      version: game?.version_actual,
      datePublished: game?.fecha_inicio,
      applicationDate: game?.fecha_inicio,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": gameCanonicalUrl,
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: gameCanonicalUrl,
      },
      inLanguage: "es",
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    })}
  />
  <div
    class="fixed inset-0 z-0 opacity-20 pointer-events-none bg-cover bg-center filter blur-[2px]"
    role="img"
    aria-label="Genshin Impact versión {game?.version_actual}"
    style=`background-image:url(${game?.imagen});`
  >
  </div>
  <main id="main-content" class="flex-1 flex flex-col items-center">
    <section class="w-full max-w-5xl px-4 sm:px-6 pt-8 sm:pt-12 mb-12 sm:mb-16">
      <div class="@container">
        <div class="flex flex-col items-center justify-center text-center mb-6 sm:mb-8">
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 border border-teal-500/40 text-teal-300 text-xs sm:text-sm font-mono font-bold tracking-widest uppercase mb-4 backdrop-blur-md shadow-[0_0_16px_rgba(45,212,191,0.2)]"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-400"
              ></span>
            </span>
            {t.gamePage.countdownToVersion}
            {game?.proxima_version}
          </div>
          <h1
            class="text-white font-display text-3xl sm:text-5xl md:text-6xl font-black leading-tight tracking-tight mb-4"
          >
            {game?.nombre_version_actual}
            <span class="text-gold italic font-serif ml-2">{game?.slogan_name}</span>
          </h1>
          <p class="text-slate-400 text-sm sm:text-base md:text-lg max-w-2xl font-medium">
            {game?.slogan_desc}
          </p>
        </div>
        <div>
          <Counter
            client:only="react"
            fecha_inicio={game?.fecha_inicio}
            duracion_dias={game?.duracion_dias}
            variant="full"
            labels={{
              days: t.counter.days,
              hours: t.counter.hours,
              minutes: t.counter.minutesFull,
              seconds: t.counter.secondsFull,
              finished: t.counter.finished,
            }}
          />
        </div>
        <div class="mt-6 sm:mt-8">
          <BannerAlert game="genshin-impact" color="var(--color-genshin-teal)" />
        </div>
        <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4 mt-6">
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={game?.patch_notes}
            title="Notas del parche oficiales de Genshin Impact en Hoyolab"
            class="flex items-center justify-center gap-2 bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-500 hover:to-emerald-500 text-white px-6 sm:px-8 py-3 min-h-[48px] rounded-xl font-display text-xs sm:text-sm font-bold uppercase tracking-wider transition-all transform hover:scale-105 shadow-[0_0_24px_rgba(45,212,191,0.3)] border border-white/20 cursor-pointer"
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true">menu_book</span>
            {t.gamePage.viewPatchNotes}
          </a>
          <GachaSalesBanner game="genshin-impact" color="var(--color-genshin-teal)" />
          <CopyButton 
            client:only="react"
            label={t.gamePage.remindMe}
            successMessage={t.gamePage.toastSuccess}
            errorMessage={t.gamePage.toastError}
          />
        </div>
      </div>
    </section>

    <!-- FAQ / SEO section -->
    <section class="w-full max-w-5xl px-4 sm:px-6 pb-12 sm:pb-16">
      <div class="rounded-3xl p-6 sm:p-10 border border-white/10 bg-[#0a0b16]/90 backdrop-blur-2xl shadow-2xl">
        <div class="flex items-center justify-center gap-2.5 mb-8">
          <span class="size-2 rounded-full bg-teal-400 shadow-[0_0_8px_#2dd4bf]"></span>
          <h2 class="font-display text-white text-xl sm:text-3xl font-black uppercase tracking-wider text-center">
            Preguntas Frecuentes Genshin Impact {game?.proxima_version}
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            faqItems.map((item) => (
              <details class="group rounded-2xl bg-white/[0.03] border border-white/10 p-5 transition-all hover:border-teal-500/40 open:border-teal-500/50 open:bg-white/[0.05]">
                <summary
                  class="cursor-pointer list-none flex items-center justify-between gap-3 font-display font-bold text-white text-sm sm:text-base"
                >
                  {item.question}
                  <span
                    class="shrink-0 text-teal-400 font-mono text-lg transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >+</span>
                </summary>
                <p class="mt-3 text-slate-300 text-sm leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
        <div class="mt-8 text-center">
          <a
            href="/es/banners"
            class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-teal-300 hover:text-teal-200 transition-colors px-4 py-2 rounded-xl bg-white/[0.04] border border-white/10 hover:border-teal-500/30"
          >
            {t.banner.viewBanners}
            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>