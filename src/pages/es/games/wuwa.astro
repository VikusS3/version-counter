---
import Layout from "../../../layouts/Layout.astro";
import { Counter } from "../../../components/react/Counter";
import { CopyButton } from "../../../components/react/CopyButton";
import { useTranslations } from "../../../i18n/utils";
import { getLocalizedGame } from "../../../data/translations/getGameData";

const t = useTranslations("es");
const game = getLocalizedGame("wuthering-waves", "es");
---

<Layout
  title={`Wuthering Waves v${game?.proxima_version} Countdown`}
  description={`Countdown to Wuthering Waves v${game?.proxima_version} release. Track version updates, maintenance schedules, and patch notes for the popular action RPG.`}
  lang="es"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoGame",
      name: `Wuthering Waves v${game?.version_actual}`,
      description: game?.descripcion,
      url: new URL("/es/games/wuwa", Astro.site).href,
      image: game?.imagen,
      genre: "Action RPG",
      operatingSystem: "iOS, Android, PC",
      publisher: {
        "@type": "Organization",
        name: "Kuro Games",
      },
      version: game?.version_actual,
    })}
  />
  <div
    class="fixed inset-0 z-0 opacity-30 pointer-events-none bg-cover bg-center"
    data-alt="Stylized landscape of Teyvat mountains at night"
    style=`background-image:url(${game?.imagen});`
  >
  </div>
  <main id="main-content" class="flex-1 flex flex-col items-center">
    <section class="w-full max-w-300 px-6 pt-12 mb-16">
      <div class="@container">
        <div class="flex flex-col items-center justify-center text-center mb-8">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/50 border border-primary/40 text-white text-sm font-bold tracking-widest uppercase mb-4"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
              ></span>
            </span>
            {t.gamePage.countdownToVersion}
            {game?.proxima_version}
          </div>
          <h1
            class="text-white text-4xl md:text-6xl font-black leading-tight tracking-tight mb-4"
          >
            {game?.nombre_version_actual}
            <span class="text-gold italic font-serif">{game?.slogan_name}</span>
          </h1>
          <p class="text-slate-400 text-lg max-w-2xl">
            {game?.slogan_desc}
          </p>
        </div>
        <div>
          <Counter
            client:only="react"
            fecha_inicio={game?.fecha_inicio}
            duracion_dias={game?.duracion_dias}
            variant="full"
            labels={{
              days: t.counter.days,
              hours: t.counter.hours,
              minutes: t.counter.minutesFull,
              seconds: t.counter.secondsFull,
              finished: t.counter.finished,
            }}
          />
        </div>
        <div class="flex justify-center gap-4 mt-8">
          <a
            target="_blank"
            rel="noopener noreferer"
            href={game?.patch_notes}
            class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-8 py-3 rounded-xl font-bold transition-all transform hover:scale-105"
          >
            <span class="material-symbols-outlined">menu_book</span>
            {t.gamePage.viewPatchNotes}
          </a>
          <CopyButton 
            client:only="react"
            label={t.gamePage.remindMe}
            successMessage={t.gamePage.toastSuccess}
            errorMessage={t.gamePage.toastError}
          />
        </div>
      </div>
    </section>
  </main>
</Layout>
