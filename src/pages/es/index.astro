---
import Layout from "../../layouts/Layout.astro";
import StatsSection from "../../components/StatsSections.astro";
import { GameDashboard } from "../../components/react/GameDashboard";
import { useTranslations } from "../../i18n/utils";
import { getLocalizedGames } from "../../data/translations/getGameData";

const t = useTranslations("es");
const games = getLocalizedGames("es");

const gameData = games.map((juego) => ({
  alias: juego.alias,
  icon: juego.icon,
  tema: juego.tema,
  href: juego.href,
  nombre_oficial: juego.nombre_oficial,
  version_actual: juego.version_actual,
  proxima_version: juego.proxima_version,
  imagen: juego.imagen,
  fecha_inicio: juego.fecha_inicio,
  duracion_dias: juego.duracion_dias,
}));

const dashboardLabels = {
  filterTitle: t.gameFilter.filterTitle,
  showAll: t.gameFilter.showAll,
  hideAll: t.gameFilter.hideAll,
  gameVisibility: t.gameFilter.gameVisibility,
  gameHidden: t.gameFilter.gameHidden,
  gameVisible: t.gameFilter.gameVisible,
  allHidden: t.gameFilter.allHidden,
  current: t.gameCard.current,
  upcoming: t.gameCard.upcoming,
  days: t.counter.days,
  hours: t.counter.hours,
  minutes: t.counter.minutes,
  seconds: t.counter.seconds,
  finished: t.counter.finished,
};

const faqItems = [
  {
    question: "¿Cómo funcionan los contadores de versiones?",
    answer: "Los contadores muestran el tiempo restante hasta la próxima actualización o parche. Cada juego tiene su propio ciclo, por lo que usamos el último calendario oficial disponible.",
  },
  {
    question: "¿Qué juegos son compatibles?",
    answer: "Rastreamos Genshin Impact, Honkai Star Rail, Wuthering Waves, Zenless Zone Zero, Arknights Endfield y Neverness to Everness.",
  },
  {
    question: "¿Los contadores son precisos para todas las regiones?",
    answer: "El contador es una estimación basada en el calendario oficial en UTC. Las ventanas de mantenimiento y lanzamiento pueden variar ligeramente según la región o el editor.",
  },
  {
    question: "¿Puedo recibir una notificación antes de un lanzamiento?",
    answer: "Usa el botón Recordarme de la página de un juego para copiar y compartir el enlace, o marca la página para acceder rápidamente.",
  },
];
---

<Layout title={t.home.title} description={t.home.subtitle} lang="es">
  <main id="main-content" class="max-w-7xl mx-auto w-full px-4 md:px-6 py-6 md:py-10">
    <section class="mb-6 md:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-2">{t.home.heroTitle}</h1>
      <p class="text-slate-500 dark:text-slate-400 max-w-2xl text-sm md:text-base">
        {t.home.subtitle}
      </p>
    </section>

    <GameDashboard client:load games={gameData} labels={dashboardLabels} locale="es" />

    <StatsSection />

    <section class="mt-12 sm:mt-16" aria-labelledby="home-faq-title">
      <h2 id="home-faq-title" class="text-2xl font-bold text-white mb-4">
        Preguntas sobre los contadores
      </h2>
      <div class="grid gap-3 md:grid-cols-2">
        {faqItems.map((item) => (
          <details class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
            <summary class="cursor-pointer font-bold text-white">{item.question}</summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  
</Layout>