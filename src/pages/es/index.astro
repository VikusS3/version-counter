---
import Layout from "../../layouts/Layout.astro";
import StatsSection from "../../components/StatsSections.astro";
import { GameDashboard } from "../../components/react/GameDashboard";
import { PromotionalPopup } from "../../components/react/PromotionalPopup";
import { useTranslations } from "../../i18n/utils";
import { getLocalizedGames } from "../../data/translations/getGameData";

const t = useTranslations("es");
const games = getLocalizedGames("es");

const gameData = games.map((juego) => ({
  alias: juego.alias,
  icon: juego.icon,
  tema: juego.tema,
  href: juego.href,
  nombre_oficial: juego.nombre_oficial,
  version_actual: juego.version_actual,
  proxima_version: juego.proxima_version,
  imagen: juego.imagen,
  fecha_inicio: juego.fecha_inicio,
  duracion_dias: juego.duracion_dias,
}));

const dashboardLabels = {
  filterTitle: t.gameFilter.filterTitle,
  showAll: t.gameFilter.showAll,
  hideAll: t.gameFilter.hideAll,
  gameVisibility: t.gameFilter.gameVisibility,
  gameHidden: t.gameFilter.gameHidden,
  gameVisible: t.gameFilter.gameVisible,
  allHidden: t.gameFilter.allHidden,
  current: t.gameCard.current,
  upcoming: t.gameCard.upcoming,
  days: t.counter.days,
  hours: t.counter.hours,
  minutes: t.counter.minutes,
  seconds: t.counter.seconds,
  finished: t.counter.finished,
};
---

<Layout title={t.home.title} description={t.home.subtitle} lang="es">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "¿Cómo funcionan los contadores de versiones?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Los contadores de versiones muestran el tiempo restante hasta la próxima actualización o lanzamiento de parche de cada juego. Cada juego tiene un ciclo típico de parches de 6 semanas.",
          },
        },
        {
          "@type": "Question",
          name: "¿Qué juegos son compatibles?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Rastreamos Genshin Impact, Honkai Star Rail, Wuthering Waves, Zenless Zone Zero, Arknights Endfield y Neverness to Everness.",
          },
        },
        {
          "@type": "Question",
          name: "¿Los contadores son precisos para todas las regiones?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Nuestros contadores se basan en los horarios oficiales de parches. Los tiempos suelen ser consistentes en todos los servidores.",
          },
        },
        {
          "@type": "Question",
          name: "¿Puedo recibir una notificación antes del lanzamiento de una versión?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "¡Sí! Puedes usar el botón 'Recordarme' en cada página del juego para copiar el enlace y compartirlo, o simplemente marca la página.",
          },
        },
      ],
    })}
  />
  <main id="main-content" class="max-w-7xl mx-auto w-full px-4 md:px-6 py-6 md:py-10">
    <section class="mb-6 md:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-2">{t.home.heroTitle}</h1>
      <p class="text-slate-500 dark:text-slate-400 max-w-2xl text-sm md:text-base">
        {t.home.subtitle}
      </p>
    </section>

    <GameDashboard client:load games={gameData} labels={dashboardLabels} />

    <StatsSection />
  </main>

  <PromotionalPopup
    client:load
    campaign={{
      storageKey: "promo-honkai-event",
      videoSrc: "/videos/honkai/collab-fate.mp4",
      posterSrc: "/version-images/honkai-star-rail-4.4.webp",
      title: "Honkai Star Rail: Colaboración Estelar",
      description:
        "No te pierdas el evento de colaboración por tiempo limitado. Adéntrate en el cosmos y reclama recompensas exclusivas antes de que se acabe el tiempo.",
      ctaLabel: "Explorar el Evento →",
      ctaHref: "/es/games/hsr",
      accentColor: "#a855f7",
    }}
  />
</Layout>