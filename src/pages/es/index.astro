---
import Layout from "../../layouts/Layout.astro";
import StatsSection from "../../components/StatsSections.astro";
import { GameDashboard } from "../../components/react/GameDashboard";
import { useTranslations } from "../../i18n/utils";
import { getLocalizedGames } from "../../data/translations/getGameData";

const t = useTranslations("es");
const games = getLocalizedGames("es");

const gameData = games.map((juego) => ({
  alias: juego.alias,
  icon: juego.icon,
  tema: juego.tema,
  href: juego.href,
  nombre_oficial: juego.nombre_oficial,
  version_actual: juego.version_actual,
  proxima_version: juego.proxima_version,
  imagen: juego.imagen,
  fecha_inicio: juego.fecha_inicio,
  duracion_dias: juego.duracion_dias,
}));

const dashboardLabels = {
  filterTitle: t.gameFilter.filterTitle,
  showAll: t.gameFilter.showAll,
  hideAll: t.gameFilter.hideAll,
  gameVisibility: t.gameFilter.gameVisibility,
  gameHidden: t.gameFilter.gameHidden,
  gameVisible: t.gameFilter.gameVisible,
  allHidden: t.gameFilter.allHidden,
  current: t.gameCard.current,
  upcoming: t.gameCard.upcoming,
  days: t.counter.days,
  hours: t.counter.hours,
  minutes: t.counter.minutes,
  seconds: t.counter.seconds,
  finished: t.counter.finished,
};
---

<Layout title={t.home.title} description={t.home.subtitle} lang="es">
  <main id="main-content" class="max-w-7xl mx-auto w-full px-6 py-10">
    <section class="mb-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-2">{t.home.heroTitle}</h1>
      <p class="text-slate-500 dark:text-slate-400 max-w-2xl">
        {t.home.subtitle}
      </p>
    </section>

    <GameDashboard client:load games={gameData} labels={dashboardLabels} />

    <StatsSection />
  </main>
</Layout>