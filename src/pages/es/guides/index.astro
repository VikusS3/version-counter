---
import Layout from "../../../layouts/Layout.astro";
import { GuideFilters } from "../../../components/react/GuideFilters";
import { guides } from "../../../data/guides";
import { useTranslations } from "../../../i18n/utils";

const t = useTranslations("es");
---

<Layout title={t.guides.title} description={t.guides.subtitle} lang="es">
  <main id="main-content" class="grow max-w-7xl mx-auto px-4 py-8 w-full">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2">{t.guides.title}</h1>
      <p class="text-slate-500 dark:text-slate-400">
        {t.guides.subtitle}
      </p>
    </div>
    <GuideFilters 
      client:only="react"
      guides={guides} 
      labels={{
        all: t.guides.all,
        noGuidesFound: t.guides.noGuidesFound,
        loadMore: t.guides.loadMore,
      }}
    />
  </main>
</Layout>