---
import Layout from "../../../layouts/Layout.astro";
import { GuideFilters } from "../../../components/react/GuideFilters";
import { guides } from "../../../data/guides";
import { useTranslations } from "../../../i18n/utils";

const t = useTranslations("es");
const guidesCanonicalUrl = new URL("/es/guides", Astro.site).href;
---

<Layout title={t.guides.title} description={t.guides.subtitle} lang="es">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: t.guides.title,
      description: t.guides.subtitle,
      url: guidesCanonicalUrl,
      mainEntity: {
        "@type": "ItemList",
        itemListElement: guides.map((guide, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "VideoObject",
            name: guide.title,
            url: guide.youtubeUrl,
            thumbnailUrl: guide.thumbnail,
          },
        })),
      },
    })}
  />
  <main id="main-content" class="grow max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 w-full">
    <div class="mb-6 sm:mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold mb-2">{t.guides.title}</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base">
        {t.guides.subtitle}
      </p>
    </div>
    <GuideFilters 
      client:only="react"
      guides={guides} 
      labels={{
        all: t.guides.all,
        noGuidesFound: t.guides.noGuidesFound,
        loadMore: t.guides.loadMore,
      }}
    />
  </main>
</Layout>