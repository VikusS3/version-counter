---
import PatchCard from "../../../components/patchComponents/PatchCard.astro";
import Layout from "../../../layouts/Layout.astro";
import { useTranslations } from "../../../i18n/utils";
import { getLocalizedGames } from "../../../data/translations/getGameData";

const t = useTranslations("es");
const games = getLocalizedGames("es");
---

<Layout title={t.patch.title} description={t.patch.subtitle} lang="es">
  <main id="main-content" class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 py-10 sm:py-16">
    <div class="mb-10 sm:mb-16">
      <div
        class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] sm:text-xs font-bold mb-4 sm:mb-6"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
          ></span>
        </span>
        LIVE UPDATES
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tighter mb-4 sm:mb-6 text-white leading-none"
      >
        THE DATABASE
      </h2>
      <p class="text-slate-400 max-w-2xl leading-relaxed text-sm sm:text-base">
        {t.patch.subtitle}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-10">
      {
        games.map((juego) => (
          <PatchCard
            title={juego.nombre_oficial}
            currentVersion={juego.version_actual}
            description={juego.patch_notes_description}
            patchNotesLink={juego.patch_notes}
            icon={juego.icon}
            alias={juego.alias}
          />
        ))
      }
    </div>
  </main>
</Layout>