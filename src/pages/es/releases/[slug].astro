---
import Layout from "../../../layouts/Layout.astro";
import { ReleaseCounter } from "../../../components/react/ReleaseCounter";
import { CopyButton } from "../../../components/react/CopyButton";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import { getLocalizedRelease } from "../../../data/translations/getReleaseData";

export function getStaticPaths() {
  return [
    { params: { slug: "neverness-to-everness" } },
    { params: { slug: "silver-palace" } },
    { params: { slug: "ananta" } },
  ];
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const release = getLocalizedRelease(slug!, lang);

if (!release) {
  return Astro.redirect("/es/releases");
}

const now = new Date();
const releaseDate = new Date(release.fecha_salida);
const isReleased = releaseDate <= now;

const releaseCanonicalUrl = new URL(`/es/releases/${slug}`, Astro.site).href;
const releaseImage = new URL(release.imagen ?? "/og-image.webp", Astro.site).href;

const releaseDateText = releaseDate.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const gameName = release.nombre_oficial;

const faqItems = [
  {
    question: `¿Cuándo sale ${gameName}?`,
    answer: `${gameName} tiene fecha de lanzamiento prevista para el ${releaseDateText}. La cuenta regresiva en vivo de arriba muestra el tiempo exacto que falta para el estreno.`,
  },
  {
    question: `¿En qué plataformas estará disponible ${gameName}?`,
    answer: `${gameName} está previsto para PC, PlayStation 5, iOS y Android con progreso multiplataforma.`,
  },
  {
    question: `¿Es gratis ${gameName}?`,
    answer: `Sí, ${gameName} es free-to-play con compras opcionales dentro del juego.`,
  },
  {
    question: `¿Qué es ${gameName}?`,
    answer: release.descripcion,
  },
];

const releaseKeywords = `
  ${gameName.toLowerCase()} fecha de lanzamiento,
  ${gameName.toLowerCase()} cuenta regresiva,
  cuando sale ${gameName.toLowerCase()},
  hora de lanzamiento ${gameName.toLowerCase()},
  plataformas ${gameName.toLowerCase()},
  ${gameName.toLowerCase()} pc ps5 ios android,
  es gratis ${gameName.toLowerCase()},
  ${gameName.toLowerCase()} rpg mundo abierto,
  juegos nuevos 2027,
  cuenta atras lanzamiento ${slug}
`;
---

<Layout
  title={isReleased ? `${release?.nombre_oficial} - ${t.release.registrationsOpen}` : `${release?.nombre_oficial} Cuenta Regresiva Fecha de Estreno`}
  description={isReleased ? `${t.release.registrationsOpen} para la beta de ${release?.nombre_oficial}. ¡Regístrate ahora para asegurar tu lugar!` : `Cuenta regresiva para el estreno de ${release?.nombre_oficial} el ${releaseDateText}. Rastrea la fecha de lanzamiento, plataformas e información oficial.`}
  keywords={releaseKeywords}
  image={releaseImage}
  canonical={releaseCanonicalUrl}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoGame",
      "@id": releaseCanonicalUrl,
      name: release?.nombre_oficial,
      alternatename: release?.nombre,
      description: release?.descripcion,
      url: releaseCanonicalUrl,
      image: releaseImage,
      genre: "Action RPG",
      applicationCategory: "GameApplication",
      operatingSystem: "iOS, Android, PC, PS5",
      publisher: {
        "@type": "Organization",
        name: release?.publisher ?? "Silver Studio",
      },
      datePublished: release?.fecha_salida,
      playMode: "MultiPlayer",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: isReleased
          ? "https://schema.org/InStock"
          : "https://schema.org/PreOrder",
        url: releaseCanonicalUrl,
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": releaseCanonicalUrl,
      },
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    })}
  />
  <div
    class="fixed inset-0 z-0 opacity-20 pointer-events-none bg-cover bg-center filter blur-[2px]"
    role="img"
    aria-label={`Imagen de fondo para ${release?.nombre_oficial}`}
    style=`background-image:url(${release?.imagen});`
  >
  </div>
  <main id="main-content" class="flex-1 flex flex-col items-center">
    <section class="w-full max-w-5xl px-4 sm:px-6 pt-8 sm:pt-12 mb-12 sm:mb-16">
      <div class="@container">
        <div class="flex flex-col items-center justify-center text-center mb-8">
          {
            isReleased ? (
              <div
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 border border-emerald-500/40 text-emerald-300 text-xs sm:text-sm font-mono font-bold tracking-widest uppercase mb-4 backdrop-blur-md shadow-[0_0_16px_rgba(52,211,153,0.2)]"
              >
                <span class="relative flex h-2 w-2">
                  <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
                  ></span>
                  <span
                    class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"
                  ></span>
                </span>
                {t.release.registrationsOpen}
              </div>
            ) : (
              <div
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 border border-purple-500/40 text-purple-300 text-xs sm:text-sm font-mono font-bold tracking-widest uppercase mb-4 backdrop-blur-md shadow-[0_0_16px_rgba(168,85,247,0.25)]"
              >
                <span class="relative flex h-2 w-2">
                  <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"
                  ></span>
                  <span
                    class="relative inline-flex rounded-full h-2 w-2 bg-purple-400"
                  ></span>
                </span>
                {t.release.comingSoon}
              </div>
            )
          }
          <h1
            class="text-white font-display text-4xl sm:text-5xl md:text-6xl font-black leading-tight tracking-tight mb-4"
          >
            {release?.nombre_oficial}
          </h1>
          <p class="text-slate-400 text-base sm:text-lg max-w-2xl font-medium">
            {release?.descripcion}
          </p>
        </div>
        {
          isReleased ? (
            <div class="flex justify-center mt-8">
              <a
                href={release?.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-display text-sm sm:text-base font-bold uppercase tracking-wider transition-all transform hover:scale-105 shadow-[0_0_24px_rgba(52,211,153,0.35)] border border-white/20 cursor-pointer"
              >
                <span class="material-symbols-outlined text-lg" aria-hidden="true">login</span>
                {t.release.registerNow}
              </a>
            </div>
          ) : (
            <>
              <div>
                <ReleaseCounter
                  client:only="react"
                  fecha_salida={release.fecha_salida}
                  variant="full"
                  labels={{
                    days: t.counter.days,
                    hours: t.counter.hours,
                    minutes: t.counter.minutesFull,
                    seconds: t.counter.secondsFull,
                    finished: t.release.released,
                  }}
                />
              </div>
              <div class="flex justify-center gap-4 mt-8">
                <CopyButton
                  client:only="react"
                  label={t.gamePage.remindMe}
                  successMessage={t.gamePage.toastSuccess}
                  errorMessage={t.gamePage.toastError}
                />
              </div>
            </>
          )
        }
      </div>
    </section>

    <!-- FAQ / SEO section -->
    <section class="w-full max-w-5xl px-4 sm:px-6 pb-12 sm:pb-16">
      <div class="rounded-3xl p-6 sm:p-10 border border-white/10 bg-[#0a0b16]/90 backdrop-blur-2xl shadow-2xl">
        <div class="flex items-center justify-center gap-2.5 mb-8">
          <span class="size-2 rounded-full bg-purple-400 shadow-[0_0_8px_#c084fc]"></span>
          <h2 class="font-display text-white text-xl sm:text-3xl font-black uppercase tracking-wider text-center">
            {release?.nombre_oficial}: Preguntas Frecuentes
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            faqItems.map((item) => (
              <details class="group rounded-2xl bg-white/[0.03] border border-white/10 p-5 transition-all hover:border-purple-500/40 open:border-purple-500/50 open:bg-white/[0.05]">
                <summary
                  class="cursor-pointer list-none flex items-center justify-between gap-3 font-display font-bold text-white text-sm sm:text-base"
                >
                  {item.question}
                  <span
                    class="shrink-0 text-purple-400 font-mono text-lg transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >+</span>
                </summary>
                <p class="mt-3 text-slate-300 text-sm leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>