---
import Layout from "../../layouts/Layout.astro";
import { GuideFilters } from "../../components/react/GuideFilters";
import { guides } from "../../data/guides";
---

<Layout
  title="Character Guides"
  description="Expert character guides for Genshin Impact, Wuthering Waves, Zenless Zone Zero, and Honkai Star Rail. Build optimal teams with video tutorials from top players."
>
  <main id="main-content" class="grow max-w-7xl mx-auto px-4 py-8 w-full">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2">Character Guides</h1>
      <p class="text-slate-500 dark:text-slate-400">
        Master your favorite characters with curated expert video guides from
        the community.
      </p>
    </div>
    <GuideFilters client:load guides={guides} />
  </main>
</Layout>
