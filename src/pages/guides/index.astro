---
import Layout from "../../layouts/Layout.astro";
import { GuideFilters } from "../../components/react/GuideFilters";
import { guides } from "../../data/guides";
---

<Layout title="">
  <main class="grow max-w-7xl mx-auto px-4 py-8 w-full">
    <div class="mb-8">
      <h2 class="text-4xl font-bold mb-2">Character Guides</h2>
      <p class="text-slate-500 dark:text-slate-400">
        Master your favorite characters with curated expert video guides from
        the community.
      </p>
    </div>
    <GuideFilters client:load guides={guides} />
  </main>
</Layout>
