---
import Layout from "../../layouts/Layout.astro";
import { Counter } from "../../components/react/Counter";
import { CopyButton } from "../../components/react/CopyButton";
import BannerAlert from "../../components/bannerComponents/BannerAlert.astro";
import GachaSalesBanner from "../../components/bannerComponents/GachaSalesBanner.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getLocalizedGame } from "../../data/translations/getGameData";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const game = getLocalizedGame("honkai-star-rail", lang);

const nextVersionDate = new Date(
  Date.parse(game?.fecha_inicio ?? "") +
    (game?.duracion_dias ?? 42) * 24 * 60 * 60 * 1000
);
const nextVersionDateText = nextVersionDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const faqItems = [
  {
    question: `When does Honkai Star Rail ${game?.proxima_version} release?`,
    answer: `The Honkai Star Rail ${game?.proxima_version} update is expected to release around ${nextVersionDateText}, following the standard ${game?.duracion_dias}-day patch cycle. The exact release time is shown in the live countdown above.`,
  },
  {
    question: "What version is Honkai Star Rail on right now?",
    answer: `Honkai Star Rail is currently on version ${game?.version_actual}, and the next major update is version ${game?.proxima_version}.`,
  },
  {
    question: `Where can I check the official Honkai Star Rail ${game?.version_actual} patch notes?`,
    answer:
      'You can read the official Honkai Star Rail patch notes on Hoyolab, linked from the "View Patch Notes" button on this page.',
  },
  {
    question: "What are the scheduled server maintenance times for Honkai Star Rail?",
    answer:
      "Honkai Star Rail maintenance usually starts a few hours before version release. The countdown on this page tracks the exact update time for the America, Europe, and Asia servers.",
  },
];

const gameCanonicalUrl = new URL("/games/hsr", Astro.site).href;
const gameImage = new URL(game?.imagen ?? "/og-image.webp", Astro.site).href;

const gameKeywords = `
  honkai star rail ${game?.proxima_version} countdown,
  honkai star rail ${game?.proxima_version} release date,
  honkai star rail ${game?.proxima_version} release time,
  honkai star rail update time,
  honkai star rail banner schedule,
  honkai star rail next version,
  honkai star rail maintenance schedule,
  honkai star rail patch notes,
  honkai star rail ${game?.version_actual} banners,
  honkai star rail ${game?.version_actual} characters,
  honkai star rail stellar jades,
  when is honkai star rail ${game?.proxima_version} coming out,
  honkai star rail america server countdown,
  honkai star rail version ${game?.version_actual}
`;
---

<Layout
  title={`Honkai Star Rail ${game?.proxima_version} Release Countdown - Banners & Patch Notes`}
  description={`Honkai Star Rail ${game?.proxima_version} countdown to release for America, Europe, and Asia servers. Track the update time, banner schedule, maintenance, and official patch notes.`}
  keywords={gameKeywords}
  image={gameImage}
  canonical={gameCanonicalUrl}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoGame",
      "@id": gameCanonicalUrl,
      name: `Honkai Star Rail v${game?.version_actual}`,
      alternatename: `Honkai Star Rail ${game?.proxima_version}`,
      description: game?.descripcion,
      url: gameCanonicalUrl,
      image: gameImage,
      genre: "Space Fantasy RPG",
      applicationCategory: "GameApplication",
      operatingSystem: "iOS, Android, PC, PS5",
      publisher: {
        "@type": "Organization",
        name: "HoYoverse",
        url: "https://www.hoyoverse.com",
      },
      version: game?.version_actual,
      datePublished: game?.fecha_inicio,
      applicationDate: game?.fecha_inicio,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": gameCanonicalUrl,
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: gameCanonicalUrl,
      },
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    })}
  />
  <div
    class="fixed inset-0 z-0 opacity-20 pointer-events-none bg-cover bg-center filter blur-[2px]"
    role="img"
    aria-label="Honkai Star Rail version {game?.version_actual} background artwork"
    style=`background-image:url(${game?.imagen});`
  >
  </div>
  <main id="main-content" class="flex-1 flex flex-col items-center">
    <!-- HeroSection & Countdown -->
    <section class="w-full max-w-5xl px-4 sm:px-6 pt-8 sm:pt-12 mb-12 sm:mb-16">
      <div class="@container">
        <div
          class="flex flex-col items-center justify-center text-center mb-6 sm:mb-8"
        >
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 border border-purple-500/40 text-purple-300 text-xs sm:text-sm font-mono font-bold tracking-widest uppercase mb-4 backdrop-blur-md shadow-[0_0_16px_rgba(192,132,252,0.2)]"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-purple-400"
              ></span>
            </span>
            {t.gamePage.countdownToVersion}
            {game?.proxima_version}
          </div>
          <h1
            class="text-white font-display text-3xl sm:text-5xl md:text-6xl font-black leading-tight tracking-tight mb-4"
          >
            {game?.nombre_version_actual}
            <span class="text-gold italic font-serif ml-2">{game?.slogan_name}</span>
          </h1>
          <p class="text-slate-400 text-sm sm:text-base md:text-lg max-w-2xl font-medium">
            {game?.slogan_desc}
          </p>
        </div>

        <div>
          <Counter
            client:only="react"
            fecha_inicio={game?.fecha_inicio}
            duracion_dias={game?.duracion_dias}
            variant="full"
            labels={{
              days: t.counter.days,
              hours: t.counter.hours,
              minutes: t.counter.minutesFull,
              seconds: t.counter.secondsFull,
              finished: t.counter.finished,
            }}
          />
        </div>
        <div class="mt-6 sm:mt-8">
          <BannerAlert
            game="honkai-star-rail"
            color="var(--color-hsr-purple)"
          />
        </div>
        <div
          class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4 mt-6"
        >
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={game?.patch_notes}
            title="Official Honkai Star Rail patch notes on Hoyolab"
            class="flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white px-6 sm:px-8 py-3 min-h-[48px] rounded-xl font-display text-xs sm:text-sm font-bold uppercase tracking-wider transition-all transform hover:scale-105 shadow-[0_0_24px_rgba(192,132,252,0.3)] border border-white/20 cursor-pointer"
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true"
              >menu_book</span
            >
            {t.gamePage.viewPatchNotes}
          </a>
          <GachaSalesBanner game="honkai-star-rail" color="var(--color-hsr-purple)" />
          <CopyButton
            client:only="react"
            label={t.gamePage.remindMe}
            successMessage={t.gamePage.toastSuccess}
            errorMessage={t.gamePage.toastError}
          />
        </div>
      </div>
    </section>

    <!-- FAQ / SEO section -->
    <section class="w-full max-w-5xl px-4 sm:px-6 pb-12 sm:pb-16">
      <div class="rounded-3xl p-6 sm:p-10 border border-white/10 bg-[#0a0b16]/90 backdrop-blur-2xl shadow-2xl">
        <div class="flex items-center justify-center gap-2.5 mb-8">
          <span class="size-2 rounded-full bg-purple-400 shadow-[0_0_8px_#c084fc]"></span>
          <h2 class="font-display text-white text-xl sm:text-3xl font-black uppercase tracking-wider text-center">
            Honkai Star Rail {game?.proxima_version} FAQ
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            faqItems.map((item) => (
              <details class="group rounded-2xl bg-white/[0.03] border border-white/10 p-5 transition-all hover:border-purple-500/40 open:border-purple-500/50 open:bg-white/[0.05]">
                <summary
                  class="cursor-pointer list-none flex items-center justify-between gap-3 font-display font-bold text-white text-sm sm:text-base"
                >
                  {item.question}
                  <span
                    class="shrink-0 text-purple-400 font-mono text-lg transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >+</span>
                </summary>
                <p class="mt-3 text-slate-300 text-sm leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
        <div class="mt-8 text-center">
          <a
            href="/banners"
            class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-purple-300 hover:text-purple-200 transition-colors px-4 py-2 rounded-xl bg-white/[0.04] border border-white/10 hover:border-purple-500/30"
          >
            {t.banner.viewBanners}
            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
