---
import Layout from "../../layouts/Layout.astro";
import { Counter } from "../../components/react/Counter";
import { CopyButton } from "../../components/react/CopyButton";
import BannerAlert from "../../components/bannerComponents/BannerAlert.astro";
import GachaSalesBanner from "../../components/bannerComponents/GachaSalesBanner.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getLocalizedGame } from "../../data/translations/getGameData";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const game = getLocalizedGame("wuthering-waves", lang);

const nextVersionDate = new Date(
  Date.parse(game?.fecha_inicio ?? "") +
    (game?.duracion_dias ?? 42) * 24 * 60 * 60 * 1000
);
const nextVersionDateText = nextVersionDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const faqItems = [
  {
    question: `When does Wuthering Waves ${game?.proxima_version} release?`,
    answer: `The Wuthering Waves ${game?.proxima_version} update is expected to release around ${nextVersionDateText}, following the standard ${game?.duracion_dias}-day patch cycle. The exact release time is shown in the live countdown above.`,
  },
  {
    question: "What version is Wuthering Waves on right now?",
    answer: `Wuthering Waves is currently on version ${game?.version_actual}, and the next major update is version ${game?.proxima_version}.`,
  },
  {
    question: `Where can I check the official Wuthering Waves ${game?.version_actual} patch notes?`,
    answer:
      'You can read the official Wuthering Waves patch notes on the Kuro Games official site, linked from the "View Patch Notes" button on this page.',
  },
  {
    question: "What are the scheduled server maintenance times for Wuthering Waves?",
    answer:
      "Wuthering Waves maintenance usually starts a few hours before version release. The countdown on this page tracks the exact update time for the America, Europe, and Asia servers.",
  },
];

const gameCanonicalUrl = new URL("/games/wuwa", Astro.site).href;
const gameImage = new URL(game?.imagen ?? "/og-image.webp", Astro.site).href;

const gameKeywords = `
  wuthering waves ${game?.proxima_version} countdown,
  wuthering waves ${game?.proxima_version} release date,
  wuthering waves ${game?.proxima_version} release time,
  wuthering waves update time,
  wuthering waves banner schedule,
  wuthering waves next version,
  wuthering waves maintenance schedule,
  wuthering waves patch notes,
  wuthering waves ${game?.version_actual} banners,
  wuthering waves ${game?.version_actual} characters,
  wuthering waves astrite,
  when is wuthering waves ${game?.proxima_version} coming out,
  wuthering waves america server countdown,
  wuthering waves version ${game?.version_actual}
`;
---

<Layout
  title={`Wuthering Waves ${game?.proxima_version} Release Countdown - Banners & Patch Notes`}
  description={`Wuthering Waves ${game?.proxima_version} countdown to release for America, Europe, and Asia servers. Track the update time, banner schedule, maintenance, and official patch notes.`}
  keywords={gameKeywords}
  image={gameImage}
  canonical={gameCanonicalUrl}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoGame",
      "@id": gameCanonicalUrl,
      name: `Wuthering Waves v${game?.version_actual}`,
      alternatename: `Wuthering Waves ${game?.proxima_version}`,
      description: game?.descripcion,
      url: gameCanonicalUrl,
      image: gameImage,
      genre: "Action RPG",
      applicationCategory: "GameApplication",
      operatingSystem: "iOS, Android, PC",
      publisher: {
        "@type": "Organization",
        name: "Kuro Games",
        url: "https://wutheringwaves.kurogames.com",
      },
      version: game?.version_actual,
      datePublished: game?.fecha_inicio,
      applicationDate: game?.fecha_inicio,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": gameCanonicalUrl,
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: gameCanonicalUrl,
      },
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    })}
  />
  <div
    class="fixed inset-0 z-0 opacity-30 pointer-events-none bg-cover bg-center"
    role="img"
    aria-label="Wuthering Waves version {game?.version_actual} background artwork"
    style=`background-image:url(${game?.imagen});`
  >
  </div>
  <main id="main-content" class="flex-1 flex flex-col items-center">
    <!-- HeroSection & Countdown -->
    <section class="w-full max-w-300 px-4 sm:px-6 pt-8 sm:pt-12 mb-12 sm:mb-16">
      <div class="@container">
        <div class="flex flex-col items-center justify-center text-center mb-6 sm:mb-8">
          <div
            class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1 rounded-full bg-primary/50 border border-primary/40 text-white text-[11px] sm:text-sm font-bold tracking-widest uppercase mb-3 sm:mb-4"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
              ></span>
            </span>
            {t.gamePage.countdownToVersion}
            {game?.proxima_version}
          </div>
          <h1
            class="text-white text-3xl sm:text-4xl md:text-6xl font-black leading-tight tracking-tight mb-3 sm:mb-4"
          >
            {game?.nombre_version_actual}
            <span class="text-gold italic font-serif">{game?.slogan_name}</span>
          </h1>
          <p class="text-slate-400 text-sm sm:text-base md:text-lg max-w-2xl">
            {game?.slogan_desc}
          </p>
        </div>
        <!-- Large Timer -->
        <div>
          <Counter
            client:only="react"
            fecha_inicio={game?.fecha_inicio}
            duracion_dias={game?.duracion_dias}
            variant="full"
            labels={{
              days: t.counter.days,
              hours: t.counter.hours,
              minutes: t.counter.minutesFull,
              seconds: t.counter.secondsFull,
              finished: t.counter.finished,
            }}
          />
        </div>
        <div class="mt-6 sm:mt-8">
          <BannerAlert game="wuthering-waves" color="var(--color-wuwa-blue)" />
        </div>
        <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4 mt-3 sm:mt-4">
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={game?.patch_notes}
            title="Official Wuthering Waves patch notes on Kuro Games"
            class="flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 sm:px-8 py-3 min-h-[48px] rounded-xl font-bold transition-all transform hover:scale-105"
          >
            <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
            {t.gamePage.viewPatchNotes}
          </a>
          <GachaSalesBanner game="wuthering-waves" color="var(--color-wuwa-blue)" />
          <CopyButton 
            client:only="react"
            label={t.gamePage.remindMe}
            successMessage={t.gamePage.toastSuccess}
            errorMessage={t.gamePage.toastError}
          />
        </div>
      </div>
    </section>

    <!-- FAQ / SEO section -->
    <section class="w-full max-w-300 px-4 sm:px-6 pb-12 sm:pb-16">
      <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-white/10">
        <h2 class="text-white text-2xl sm:text-3xl font-bold mb-6 text-center">
          Wuthering Waves {game?.proxima_version} FAQ
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            faqItems.map((item) => (
              <details class="group rounded-xl bg-white/5 border border-white/10 p-4 sm:p-5">
                <summary
                  class="cursor-pointer list-none flex items-center justify-between gap-3 font-semibold text-white text-sm sm:text-base"
                >
                  {item.question}
                  <span
                    class="shrink-0 text-gold transition-transform group-open:rotate-45"
                    aria-hidden="true"
                  >+</span>
                </summary>
                <p class="mt-3 text-slate-300 text-sm leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
        <div class="mt-8 text-center">
          <a
            href="/banners"
            class="inline-flex items-center gap-2 text-blue-300 hover:text-blue-200 font-semibold text-sm sm:text-base"
          >
            {t.banner.viewBanners}
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
