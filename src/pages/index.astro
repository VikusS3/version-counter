---
import StatsSection from "../components/StatsSections.astro";
import Layout from "../layouts/Layout.astro";
import GameCard from "../components/GameCard.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getLocalizedGames } from "../data/translations/getGameData";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const games = getLocalizedGames(lang);
---

<Layout title={t.home.title} description={t.home.subtitle}>
  <main
    id="main-content"
    class="max-w-7xl mx-auto w-full px-4 md:px-6 py-8 md:py-10"
  >
    <!-- Hero -->
    <section class="mb-8 md:mb-10">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-2">
        {t.home.heroTitle}
      </h1>
      <p
        class="text-slate-500 dark:text-slate-400 max-w-2xl text-sm md:text-base"
      >
        {t.home.subtitle}
      </p>
    </section>

    <!-- Cards -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        games.map((juego) => (
          <GameCard
            title={juego.nombre_oficial}
            current={juego.version_actual}
            upcoming={juego.proxima_version}
            imagen={juego.imagen}
            fecha_inicio={juego.fecha_inicio}
            duracion_dias={juego.duracion_dias}
            tema={juego.tema}
            href={juego.href}
            alias={juego.alias}
          />
        ))
      }
    </section>
    <StatsSection />
  </main>
</Layout>
