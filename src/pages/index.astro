---
import StatsSection from "../components/StatsSections.astro";
import Layout from "../layouts/Layout.astro";
import { GameDashboard } from "../components/react/GameDashboard";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getLocalizedGames } from "../data/translations/getGameData";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const games = getLocalizedGames(lang);

const gameData = games.map((juego) => ({
  alias: juego.alias,
  icon: juego.icon,
  tema: juego.tema,
  href: juego.href,
  nombre_oficial: juego.nombre_oficial,
  version_actual: juego.version_actual,
  proxima_version: juego.proxima_version,
  imagen: juego.imagen,
  fecha_inicio: juego.fecha_inicio,
  duracion_dias: juego.duracion_dias,
}));

const dashboardLabels = {
  filterTitle: t.gameFilter.filterTitle,
  showAll: t.gameFilter.showAll,
  hideAll: t.gameFilter.hideAll,
  gameVisibility: t.gameFilter.gameVisibility,
  gameHidden: t.gameFilter.gameHidden,
  gameVisible: t.gameFilter.gameVisible,
  allHidden: t.gameFilter.allHidden,
  current: t.gameCard.current,
  upcoming: t.gameCard.upcoming,
  days: t.counter.days,
  hours: t.counter.hours,
  minutes: t.counter.minutes,
  seconds: t.counter.seconds,
  finished: t.counter.finished,
};

const faqItems = [
  {
    question: "How do version countdowns work?",
    answer: "Version countdowns show the time remaining until the next game update or patch release. Each game has its own patch cycle, so the countdown uses the latest official schedule available.",
  },
  {
    question: "Which games are supported?",
    answer: "We track Genshin Impact, Honkai Star Rail, Wuthering Waves, Zenless Zone Zero, Arknights Endfield, and Neverness to Everness.",
  },
  {
    question: "Are the countdowns accurate for every region?",
    answer: "The countdown is an estimate based on the official UTC schedule. Maintenance and launch windows can shift slightly by region or publisher.",
  },
  {
    question: "Can I get notified before a version releases?",
    answer: "Use the Remind Me button on a game page to copy the page link and share it, or bookmark the page for quick access.",
  },
];
---

<Layout title={t.home.title} description={t.home.subtitle}>
  <main
    id="main-content"
    class="max-w-7xl mx-auto w-full px-4 md:px-6 py-6 md:py-10"
  >
    <!-- Hero -->
    <section class="mb-6 md:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-2">
        {t.home.heroTitle}
      </h1>
      <p
        class="text-slate-500 dark:text-slate-400 max-w-2xl text-sm md:text-base"
      >
        {t.home.subtitle}
      </p>
    </section>

    <!-- Game Dashboard with Filter -->
    <GameDashboard client:load games={gameData} labels={dashboardLabels} locale="en" />

    <StatsSection />

    <section class="mt-12 sm:mt-16" aria-labelledby="home-faq-title">
      <h2 id="home-faq-title" class="text-2xl font-bold text-white mb-4">
        Version Countdown FAQ
      </h2>
      <div class="grid gap-3 md:grid-cols-2">
        {faqItems.map((item) => (
          <details class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
            <summary class="cursor-pointer font-bold text-white">{item.question}</summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <!-- 
  <PromotionalPopup
    client:load
    campaign={{
      storageKey: "promo-honkai-event",
      videoSrc: "/videos/honkai/promo.mp4",
      posterSrc: "/version-images/honkai-star-rail-4.4.webp",
      title: "Honkai Star Rail: Fate's Collab",
      description:
        "Don't miss the limited-time collaboration event. Dive into the cosmos and claim exclusive rewards before time runs out.",
      ctaLabel: "Explore the Event →",
      ctaHref: "/games/hsr",
      accentColor: "#a855f7",
    }}
  /> -->
</Layout>
