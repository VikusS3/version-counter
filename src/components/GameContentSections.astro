---
import { getCollection } from "astro:content";
import type { LocalizedGame } from "../data/translations/getGameData";

interface Props {
  game?: LocalizedGame;
  lang: "en" | "es";
}

const { game, lang } = Astro.props;

if (!game) {
  return;
}

const isEs = lang === "es";

const blogKeyMap: Record<string, string> = {
  "genshin-impact": "genshin",
  "honkai-star-rail": "hsr",
  "wuthering-waves": "wuwa",
  "zenless-zone-zero": "zzz",
  "arknights-endfield": "arknights",
  "neverness-to-everness": "nte",
};

const blogKey = blogKeyMap[game.slug];

const relatedPosts = blogKey
  ? (await getCollection("blog", ({ id }) =>
        isEs ? id.startsWith("es/") : id.startsWith("en/"),
      )).filter((post) => post.data.game === blogKey)
      .sort(
        (a, b) =>
          b.data.publishDate.getTime() - a.data.publishDate.getTime(),
      )
  : [];
const relatedPost = relatedPosts[0];

const title = `${game.nombre_oficial} v${game.version_actual}`;

const cycleText = isEs
  ? `${game.nombre_oficial} sigue un ciclo de versiones de ${game.duracion_dias} días. Cuando se lanza una versión nueva, los servidores entran en mantenimiento durante unas horas mientras se despliega la actualización. `
  : `${game.nombre_oficial} runs on a ${game.duracion_dias}-day version cycle. When a new version launches, the servers go down for maintenance for a few hours while the update is deployed.`;

const countdownText = isEs
  ? `Nuestra cuenta regresiva en vivo comienza desde la hora oficial de lanzamiento de la versión ${game.version_actual} y cuenta hasta la fecha prevista de ${game.proxima_version}, calculada con el ciclo estándar de ${game.duracion_dias} días. Cuando el temporizador llega a cero, comienza la siguiente ventana de mantenimiento; al terminar, los servidores vuelven en línea y normalmente se distribuye compensación dentro del juego. `
  : `Our live countdown starts from the official release time of version ${game.version_actual} and counts down to the expected release of ${game.proxima_version}, calculated using the standard ${game.duracion_dias}-day cycle. When the timer reaches zero, the next maintenance window begins. Once it ends, servers come back online and in-game compensation is usually distributed. `;

const disclaimerText = isEs
  ? "Estas fechas son estimaciones basadas en calendarios oficiales y pueden desplazarse unas horas según el editor."
  : "These dates are estimates based on official schedules and can shift by a few hours depending on the publisher.";

const versionSectionTitle = isEs
  ? `Sobre esta versión (${game.version_actual})`
  : `About this version (${game.version_actual})`;
const countdownSectionTitle = isEs
  ? "Cómo funciona la cuenta regresiva"
  : "How the countdown works";
const patchNotesLabel = isEs ? "Ver Notas del Parche" : "View Patch Notes";
const relatedPostLabel = isEs
  ? `Lee el artículo completo de ${game.nombre_oficial}`
  : `Read the full ${game.nombre_oficial} article`;
---

<section class="w-full max-w-5xl px-4 sm:px-6 pb-12 sm:pb-16">
  <div class="grid gap-4 sm:gap-6 md:grid-cols-2">
    <!-- About this version -->
    <article
      class="rounded-3xl p-6 sm:p-8 border border-white/10 bg-[#0a0b16]/90 backdrop-blur-2xl shadow-2xl"
    >
      <h2 class="font-display text-white text-lg sm:text-xl font-black uppercase tracking-wider mb-4 flex items-center gap-2.5">
        <span class="material-symbols-outlined text-teal-400 text-xl" aria-hidden="true">info</span>
        {versionSectionTitle}
      </h2>
      <p class="text-slate-300 text-sm leading-relaxed">
        <span class="font-semibold text-white">{title}</span>.{" "}
        {game.descripcion}
      </p>
      <p class="text-slate-300 text-sm leading-relaxed mt-3">
        {isEs
          ? `Como en cada versión, se espera una nueva rotación de banners, eventos por tiempo limitado y una ventana de mantenimiento unas horas antes del lanzamiento de la versión ${game.proxima_version}. La lista completa de cambios está en las notas del parche oficial enlazadas abajo.`
          : `As with every version, expect a new banner rotation, limited-time events, and a maintenance window a few hours before the release of version ${game.proxima_version}. The full list of changes is available in the official patch notes linked below.`}
      </p>
      <a
        href={game.patch_notes}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-5 font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider text-teal-300 hover:text-teal-200 px-4 py-2 rounded-xl bg-white/[0.04] border border-white/10 hover:border-teal-500/30 transition-colors"
      >
        <span class="material-symbols-outlined text-sm" aria-hidden="true">menu_book</span>
        {patchNotesLabel}
      </a>
    </article>

    <!-- How the countdown works -->
    <article
      class="rounded-3xl p-6 sm:p-8 border border-white/10 bg-[#0a0b16]/90 backdrop-blur-2xl shadow-2xl"
    >
      <h2 class="font-display text-white text-lg sm:text-xl font-black uppercase tracking-wider mb-4 flex items-center gap-2.5">
        <span class="material-symbols-outlined text-indigo-400 text-xl" aria-hidden="true">timer</span>
        {countdownSectionTitle}
      </h2>
      <p class="text-slate-300 text-sm leading-relaxed">
        {cycleText}
        {countdownText}
      </p>
      <p class="text-slate-400 text-xs leading-relaxed mt-3">{disclaimerText}</p>
    </article>
  </div>

  {relatedPost && (
    <a
      href={`${isEs ? "/es" : ""}/blog/${relatedPost.id.replace(/^(en|es)\//, "")}/`}
      class="group mt-4 sm:mt-6 flex items-center justify-between gap-3 rounded-2xl border border-indigo-500/25 bg-indigo-500/[0.06] px-5 sm:px-6 py-4 hover:border-indigo-400/50 transition-all"
    >
      <span class="flex items-center gap-3 text-sm text-slate-200 font-semibold">
        <span class="material-symbols-outlined text-indigo-400 shrink-0" aria-hidden="true">article</span>
        {relatedPostLabel}
      </span>
      <span class="flex items-center gap-2 font-mono text-[10px] sm:text-xs font-bold uppercase tracking-widest text-indigo-300">
        {relatedPost.data.publishDate.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        })}
        <span class="material-symbols-outlined text-base transition-transform group-hover:translate-x-1" aria-hidden="true">arrow_forward</span>
      </span>
    </a>
  )}
</section>