---
import { Counter } from "./react/Counter";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { GAME_COLORS, type GameAlias } from "../types/games";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  current,
  upcoming,
  imagen,
  fecha_inicio,
  duracion_dias,
  tema,
  href,
  alias,
} = Astro.props as {
  title: string;
  current: string;
  upcoming: string;
  imagen: string;
  fecha_inicio: string;
  duracion_dias: number;
  tema: string;
  href: string;
  alias?: GameAlias;
};

const colorMap: Record<string, string> = {
  genshin: "var(--color-genshin)",
  wuthering: "var(--color-wuwa)",
  honkai: "var(--color-hsr)",
  zenless: "var(--color-zzz)",
  nte: "var(--color-nte)",
  arknights: "var(--color-arknights)",
};

const accentColor = (alias && colorMap[alias]) || GAME_COLORS.genshin;
---

<a
  href=`games${href}`
  class="group relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-900 h-95 flex flex-col justify-end p-4 sm:p-8 transition-all"
>
  <div
    class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
    style=`background-image: linear-gradient(180deg, rgba(10, 10, 12, 0.2) 0%, rgba(10, 10, 12, 0.95) 100%), url(${imagen});`
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-4 sm:top-6 right-4 sm:right-6 glass-panel px-2.5 sm:px-3 py-1 rounded-full"
    style=`border: 1px solid ${accentColor};`
  >
    <span
      class="text-[10px] sm:text-xs font-bold tracking-widest uppercase"
      style=`color: ${tema}`>{t.gameCard.current}: v{current}</span
    >
  </div>
  <div class="relative z-10">
    <div class="flex items-center gap-2 mb-2">
      <h3 class="text-xl sm:text-2xl font-bold">{title}</h3>
      <div class="size-2 rounded-full bg-green-500 animate-pulse"></div>
    </div>
    <p class="text-slate-400 text-xs sm:text-sm mb-4 sm:mb-6">
      {t.gameCard.upcoming}: <span class="text-white font-medium"
        >v{upcoming}
      </span>
    </p>
    <Counter
      client:only="react"
      fecha_inicio={fecha_inicio}
      duracion_dias={duracion_dias}
      labels={{
        days: t.counter.days,
        hours: t.counter.hours,
        minutes: t.counter.minutes,
        seconds: t.counter.seconds,
        finished: t.counter.finished,
      }}
    />
  </div>
  <div
    class="absolute bottom-0 left-0 h-1 transition-all w-0 group-hover:w-full"
    style=`background-color: ${accentColor}`
  >
  </div>
</a>
