---
import { getLangFromUrl, useTranslations, defaultLocale } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePrefix = lang === defaultLocale ? "" : "/es";
---

<footer
  class="mt-auto border-t border-white/[0.08] bg-[#07080f]/90 backdrop-blur-xl py-8 px-4 md:px-8 relative z-10"
  role="contentinfo"
>
  <div class="max-w-7xl mx-auto flex flex-col gap-6">
    <!-- Top System Telemetry Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pb-6 border-b border-white/[0.05] text-[11px] font-mono text-slate-500">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        <span class="text-slate-400 tracking-wider">SYSTEM STATUS: <span class="text-emerald-400 font-bold">ALL TIMERS SYNCHRONIZED</span></span>
      </div>
      <div class="flex items-center gap-4 tracking-widest text-[10px] uppercase text-slate-600">
        <span>GLOBAL REFRESH: 1HZ</span>
        <span>•</span>
        <span>UTC TIMESTAMP ENGINE</span>
      </div>
    </div>

    <!-- Main Footer Content -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <!-- Copyright -->
      <p class="text-xs text-slate-500 order-2 md:order-1 text-center md:text-left font-mono">
        {t.footer.copyright.replace("{year}", String(new Date().getFullYear()))}
      </p>

      <!-- Links -->
      <div class="flex flex-wrap gap-2 md:gap-3 items-center justify-center order-1 md:order-2">
        <a
          class="text-xs text-slate-400 hover:text-indigo-300 hover:bg-white/[0.04] px-3 py-1.5 rounded-lg border border-transparent hover:border-white/10 transition-all"
          href={`${localePrefix}/privacy`}>{t.footer.privacy}</a
        >
        <a
          class="text-xs text-slate-400 hover:text-indigo-300 hover:bg-white/[0.04] px-3 py-1.5 rounded-lg border border-transparent hover:border-white/10 transition-all"
          href={`${localePrefix}/terms`}>{t.footer.terms}</a
        >
        <a
          class="text-xs text-slate-400 hover:text-indigo-300 hover:bg-white/[0.04] px-3 py-1.5 rounded-lg border border-transparent hover:border-white/10 transition-all"
          href={`${localePrefix}/contact`}>{t.footer.contact}</a
        >
        <a
          class="text-xs text-amber-300/90 hover:text-amber-200 bg-amber-500/10 hover:bg-amber-500/20 px-3 py-1.5 rounded-lg border border-amber-500/20 hover:border-amber-500/40 transition-all flex items-center gap-1.5 font-bold shadow-sm"
          href="https://ko-fi.com/vikus10181"
          target="_blank"
          rel="noopener noreferrer"
          title="Support on Ko-fi"
        >
          <span class="material-symbols-outlined text-sm text-amber-400" aria-hidden="true">favorite</span>
          Ko-fi
        </a>
      </div>
    </div>
  </div>
</footer>
