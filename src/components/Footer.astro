---
import { getLangFromUrl, useTranslations, defaultLocale } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePrefix = lang === defaultLocale ? "" : "/es";
---

<footer
  class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-transparent py-8 px-6"
  role="contentinfo"
>
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4"
  >
    <div class="flex items-center justify-between gap-6 w-full">
      <p class="text-[11px] text-slate-500 dark:text-slate-500">
        {t.footer.copyright.replace("{year}", String(new Date().getFullYear()))}
      </p>
      <div class="flex gap-4">
        <a
          class="text-[11px] text-slate-400 hover:text-primary transition-colors"
          href={`${localePrefix}/privacy`}>{t.footer.privacy}</a
        >
        <a
          class="text-[11px] text-slate-400 hover:text-primary transition-colors"
          href={`${localePrefix}/terms`}>{t.footer.terms}</a
        >
        <a
          class="text-[11px] text-slate-400 hover:text-primary transition-colors"
          href={`${localePrefix}/contact`}>{t.footer.contact}</a
        >
      </div>
    </div>
  </div>
</footer>
