---
import { getLangFromUrl, useTranslations, defaultLocale } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePrefix = lang === defaultLocale ? "" : "/es";
---

<footer
  class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-transparent py-6 px-4 md:px-6"
  role="contentinfo"
>
  <div class="max-w-7xl mx-auto">
    <!-- Main Footer Content -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 md:gap-6">
      <!-- Copyright -->
      <p class="text-xs md:text-[11px] text-slate-500 dark:text-slate-500 order-2 md:order-1">
        {t.footer.copyright.replace("{year}", String(new Date().getFullYear()))}
      </p>

      <!-- Links -->
      <div class="flex flex-wrap gap-3 md:gap-4 items-center justify-center order-1 md:order-2">
        <a
          class="text-xs md:text-[11px] text-slate-400 hover:text-primary transition-colors"
          href={`${localePrefix}/privacy`}>{t.footer.privacy}</a
        >
        <a
          class="text-xs md:text-[11px] text-slate-400 hover:text-primary transition-colors"
          href={`${localePrefix}/terms`}>{t.footer.terms}</a
        >
        <a
          class="text-xs md:text-[11px] text-slate-400 hover:text-primary transition-colors"
          href={`${localePrefix}/contact`}>{t.footer.contact}</a
        >
        <a
          class="text-xs md:text-[11px] text-slate-400 hover:text-primary transition-colors flex items-center gap-1"
          href="https://ko-fi.com/vikus10181"
          target="_blank"
          rel="noopener noreferer"
          title="Support on Ko-fi"
        >
          <span class="material-symbols-outlined text-sm">favorite</span>
          Ko-fi
        </a>
      </div>
    </div>
  </div>
</footer>
