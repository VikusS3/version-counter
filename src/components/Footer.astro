---
import { getLangFromUrl, useTranslations, defaultLocale } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localePrefix = lang === defaultLocale ? "" : "/es";
---

<footer
  class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-transparent py-6 px-4 md:px-6"
  role="contentinfo"
>
  <div class="max-w-7xl mx-auto px-0">
    <!-- Main Footer Content -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-3 md:gap-6">
      <!-- Copyright -->
      <p class="text-[11px] md:text-xs text-slate-500 dark:text-slate-500 order-2 md:order-1 text-center md:text-left">
        {t.footer.copyright.replace("{year}", String(new Date().getFullYear()))}
      </p>

      <!-- Links -->
      <div class="flex flex-wrap gap-2.5 md:gap-4 items-center justify-center order-1 md:order-2">
        <a
          class="text-[11px] md:text-xs text-slate-400 hover:text-primary transition-colors py-3"
          href={`${localePrefix}/privacy`}>{t.footer.privacy}</a
        >
        <a
          class="text-[11px] md:text-xs text-slate-400 hover:text-primary transition-colors py-3"
          href={`${localePrefix}/terms`}>{t.footer.terms}</a
        >
        <a
          class="text-[11px] md:text-xs text-slate-400 hover:text-primary transition-colors py-3"
          href={`${localePrefix}/contact`}>{t.footer.contact}</a
        >
        <a
          class="text-[11px] md:text-xs text-slate-400 hover:text-primary transition-colors flex items-center gap-1 py-3"
          href="https://ko-fi.com/vikus10181"
          target="_blank"
          rel="noopener noreferer"
          title="Support on Ko-fi"
        >
          <span class="material-symbols-outlined text-sm" aria-hidden="true">favorite</span>
          Ko-fi
        </a>
      </div>
    </div>
  </div>
</footer>
