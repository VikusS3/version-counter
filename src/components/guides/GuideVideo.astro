---
const { guide } = Astro.props;
---

<a
  href={guide.youtubeUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group cursor-pointer"
>
  <div
    class="relative aspect-video rounded-xl overflow-hidden mb-3 bg-slate-800"
  >
    <img
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      src={guide.thumbnail}
      alt={guide.title}
    />
    <div
      class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
    >
      <span class="material-symbols-outlined text-5xl text-white"
        >play_circle</span
      >
    </div>
    <div
      class={`absolute top-2 left-2 bg-${guide.game} text-black text-[10px] font-black px-2 py-0.5 rounded uppercase`}
    >
      {guide.game}
    </div>
    <div
      class="absolute bottom-2 right-2 bg-black/60 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-0.5 rounded"
    >
      {guide.duration}
    </div>
  </div>
  <div class="flex gap-3">
    <div class="size-8 shrink-0 rounded-full bg-slate-200 overflow-hidden">
      <img
        src={guide.creator.avatar}
        alt={guide.creator.name}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="flex flex-col">
      <h3
        class="font-bold text-sm line-clamp-2 leading-snug group-hover:text-primary transition-colors"
      >
        {guide.title}
      </h3>
      <div class="flex items-center gap-2 mt-1">
        <span class="text-xs text-slate-500 font-medium"
          >{guide.creator.name}</span
        >
        <span class="size-1 bg-slate-500 rounded-full"></span>
        <span
          class="text-[10px] font-bold bg-slate-200 dark:bg-primary/20 px-1.5 rounded uppercase"
        >
          {guide.language}
        </span>
      </div>
    </div>
  </div>
</a>
