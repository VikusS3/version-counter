---
const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath.startsWith(href);
};
---

<header
  class="flex items-center justify-between border-b border-solid border-slate-200 dark:border-slate-800 px-6 py-4 sticky top-0 bg-background-light/80 backdrop-blur-md z-50"
  role="banner"
>
  <div class="">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/logo.webp"
        alt="Gacha Countdown Logo"
        class="w-8 h-8 aspect-auto rounded-md"
      />

      <h2 class="text-xl font-bold tracking-tight">Gacha Countdown</h2>
    </a>
  </div>
  <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href="/"
      aria-current={isActive("/") ? "page" : undefined}>Dashboard</a
    >
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/patch/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href="/patch/"
      aria-current={isActive("/patch/") ? "page" : undefined}>Patch Notes</a
    >
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/guides/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href="/guides/"
      aria-current={isActive("/guides/") ? "page" : undefined}>Character Guides</a
    >
    <!-- <a
      class="text-sm font-semibold text-slate-500 dark:text-slate-400 hover:text-primary transition-colors cursor-not-allowed"
      href="#">Pull Tracker</a
    > -->
  </nav>
</header>
