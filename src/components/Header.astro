---
import {
  getLangFromUrl,
  useTranslations,
  getLocalizedUrl,
  defaultLocale,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath.startsWith(href);
};

const currentLocale = lang;
const targetLocale = currentLocale === defaultLocale ? "es" : defaultLocale;
const localizedHomeUrl = getLocalizedUrl(Astro.url, targetLocale);
---

<header
  class="flex items-center justify-between border-b border-solid border-slate-200 dark:border-slate-800 px-4 md:px-6 py-3 sticky top-0 bg-background-light/80 backdrop-blur-md z-50"
  role="banner"
>
  <div class="">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/logo.webp"
        alt="Gacha Countdown Logo"
        class="w-7 h-7 md:w-8 md:h-8 aspect-auto rounded-md"
      />

      <h2 class="text-lg md:text-xl font-bold tracking-tight">
        Gacha Countdown
      </h2>
    </a>
  </div>

  <!-- Desktop Navigation -->
  <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href={currentLocale === defaultLocale ? "/" : "/es/"}
      aria-current={isActive("/") || isActive("/es/") ? "page" : undefined}
      >{t.nav.dashboard}</a
    >
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/patch/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href={currentLocale === defaultLocale ? "/patch/" : "/es/patch/"}
      aria-current={isActive("/patch/") || isActive("/es/patch/")
        ? "page"
        : undefined}>{t.nav.patchNotes}</a
    >
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/guides/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href={currentLocale === defaultLocale ? "/guides/" : "/es/guides/"}
      aria-current={isActive("/guides/") || isActive("/es/guides/")
        ? "page"
        : undefined}>{t.nav.characterGuides}</a
    >
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/releases/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href={currentLocale === defaultLocale ? "/releases/" : "/es/releases/"}
      aria-current={isActive("/releases/") || isActive("/es/releases/")
        ? "page"
        : undefined}>{t.nav.releases}</a
    >
    <div class="flex items-center gap-4">
      <a
        href={localizedHomeUrl}
        class="text-sm font-semibold text-slate-500 dark:text-slate-400 hover:text-primary transition-colors flex items-center gap-1"
        title={t.footer.language}
      >
        <span class="material-symbols-outlined text-lg">language</span>
        <span class="uppercase text-xs">{currentLocale}</span>
      </a>
    </div>
  </nav>

  <!-- Mobile Menu Button -->
  <button
    id="mobile-menu-btn"
    class="md:hidden p-2 text-slate-500 dark:text-slate-400 hover:text-primary transition-colors"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="material-symbols-outlined text-2xl">menu</span>
  </button>
</header>

<!-- Mobile Menu Panel -->
<div
  id="mobile-menu"
  class="md:hidden fixed inset-0 top-14.25 bg-background-dark/95 backdrop-blur-lg z-40 hidden"
  role="dialog"
  aria-label="Mobile navigation"
>
  <nav class="flex flex-col px-6 py-8 gap-2">
    <a
      class={`mobile-nav-link text-2xl font-bold py-4 border-b border-slate-800 ${
        isActive("/") ? "text-primary" : "text-slate-300"
      }`}
      href={currentLocale === defaultLocale ? "/" : "/es/"}>{t.nav.dashboard}</a
    >
    <a
      class={`mobile-nav-link text-2xl font-bold py-4 border-b border-slate-800 ${
        isActive("/patch/") ? "text-primary" : "text-slate-300"
      }`}
      href={currentLocale === defaultLocale ? "/patch/" : "/es/patch/"}
      >{t.nav.patchNotes}</a
    >
    <a
      class={`mobile-nav-link text-2xl font-bold py-4 border-b border-slate-800 ${
        isActive("/guides/") ? "text-primary" : "text-slate-300"
      }`}
      href={currentLocale === defaultLocale ? "/guides/" : "/es/guides/"}
      >{t.nav.characterGuides}</a
    >
    <a
      class={`mobile-nav-link text-2xl font-bold py-4 border-b border-slate-800 ${
        isActive("/releases/") ? "text-primary" : "text-slate-300"
      }`}
      href={currentLocale === defaultLocale ? "/releases/" : "/es/releases/"}
      >{t.nav.releases}</a
    >
    <a
      class="mobile-nav-link text-2xl font-bold py-4 border-b border-slate-800 text-slate-300 flex items-center gap-2"
      href={localizedHomeUrl}
    >
      <span class="material-symbols-outlined">language</span>
      <span class="uppercase">{currentLocale}</span>
    </a>
  </nav>
</div>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    function closeMenu() {
      mobileMenu?.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
      menuBtn?.setAttribute("aria-label", "Open menu");
      document.body.style.overflow = "";
    }

    menuBtn?.addEventListener("click", () => {
      const isOpen = !mobileMenu?.classList.contains("hidden");

      if (isOpen) {
        closeMenu();
      } else {
        mobileMenu?.classList.remove("hidden");
        menuBtn?.setAttribute("aria-expanded", "true");
        menuBtn?.setAttribute("aria-label", "Close menu");
        document.body.style.overflow = "hidden";
      }
    });

    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
  initMobileMenu();
</script>

<style>
  .mobile-nav-link {
    animation: slideIn 0.3s ease-out forwards;
    opacity: 0;
  }

  .mobile-nav-link:nth-child(1) {
    animation-delay: 0.05s;
  }
  .mobile-nav-link:nth-child(2) {
    animation-delay: 0.1s;
  }
  .mobile-nav-link:nth-child(3) {
    animation-delay: 0.15s;
  }
  .mobile-nav-link:nth-child(4) {
    animation-delay: 0.2s;
  }
  .mobile-nav-link:nth-child(5) {
    animation-delay: 0.25s;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
