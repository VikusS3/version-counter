---
import {
  getLangFromUrl,
  useTranslations,
  getLocalizedUrl,
  defaultLocale,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath.startsWith(href);
};

const currentLocale = lang;
const targetLocale = currentLocale === defaultLocale ? "es" : defaultLocale;
const localizedHomeUrl = getLocalizedUrl(Astro.url, targetLocale);
---

<header
  class="flex items-center justify-between border-b border-solid border-slate-200 dark:border-slate-800 px-4 md:px-6 py-3 sticky top-0 bg-background-light/80 backdrop-blur-md z-50"
  role="banner"
>
  <div class="">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/logo.webp"
        alt="Gacha Countdown Logo"
        class="w-7 h-7 md:w-8 md:h-8 aspect-auto rounded-md"
      />

      <h2 class="text-lg md:text-xl font-bold tracking-tight">
        Gacha Countdown
      </h2>
    </a>
  </div>

  <!-- Desktop Navigation -->
  <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href={currentLocale === defaultLocale ? "/" : "/es/"}
      aria-current={isActive("/") || isActive("/es/") ? "page" : undefined}
      >{t.nav.dashboard}</a
    >
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/banners/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href={currentLocale === defaultLocale ? "/banners/" : "/es/banners/"}
      aria-current={isActive("/banners/") || isActive("/es/banners/")
        ? "page"
        : undefined}>{t.nav.currentBanners}</a
    >
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/guides/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href={currentLocale === defaultLocale ? "/guides/" : "/es/guides/"}
      aria-current={isActive("/guides/") || isActive("/es/guides/")
        ? "page"
        : undefined}>{t.nav.characterGuides}</a
    >
    <a
      class={`text-sm font-semibold transition-colors nav-link ${
        isActive("/releases/")
          ? "text-primary nav-link-active"
          : "text-slate-500 dark:text-slate-400 hover:text-primary"
      }`}
      href={currentLocale === defaultLocale ? "/releases/" : "/es/releases/"}
      aria-current={isActive("/releases/") || isActive("/es/releases/")
        ? "page"
        : undefined}>{t.nav.releases}</a
    >
    <div class="flex items-center gap-4">
      <a
        href={localizedHomeUrl}
        class="text-sm font-semibold text-slate-500 dark:text-slate-400 hover:text-primary transition-colors flex items-center gap-1"
        title={t.footer.language}
      >
        <span class="material-symbols-outlined text-lg">language</span>
        <span class="uppercase text-xs">{currentLocale}</span>
      </a>
    </div>
  </nav>

  <!-- Mobile Menu Button -->
  <button
    id="mobile-menu-btn"
    class="md:hidden p-3 text-slate-500 dark:text-slate-400 hover:text-primary transition-colors min-w-[48px] min-h-12 flex items-center justify-center"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="material-symbols-outlined text-2xl" aria-hidden="true"
      >menu</span
    >
  </button>
</header>

<!-- Mobile Menu Backdrop -->
<div
  id="mobile-backdrop"
  class="md:hidden fixed inset-0 bg-black/60 z-40 hidden"
  aria-hidden="true"
>
</div>

<!-- Mobile Menu Panel -->
<div
  id="mobile-menu"
  class="md:hidden fixed top-0 right-0 h-full w-[85vw] max-w-sm bg-background-dark/98 backdrop-blur-xl z-50 translate-x-full transition-transform duration-300 ease-out"
  role="dialog"
  aria-label="Mobile navigation"
  aria-modal="true"
>
  <div class="flex items-center justify-between px-6 pt-4 pb-2 safe-top">
    <span class="text-sm font-bold text-slate-500 uppercase tracking-widest"
      >{t.nav.dashboard}</span
    >
    <button
      id="mobile-close-btn"
      class="p-3 text-slate-400 hover:text-primary transition-colors min-w-12 min-h-12 flex items-center justify-center"
      aria-label="Close menu"
    >
      <span class="material-symbols-outlined text-2xl" aria-hidden="true"
        >close</span
      >
    </button>
  </div>
  <nav
    class="flex flex-col px-6 py-4 gap-1 overflow-y-auto max-h-[calc(100vh-5rem)]"
    aria-label="Mobile"
  >
    <a
      class={`mobile-nav-link text-xl md:text-2xl font-bold py-4 px-3 rounded-xl transition-colors ${
        isActive("/")
          ? "text-primary bg-primary/10"
          : "text-slate-300 hover:bg-white/5"
      }`}
      href={currentLocale === defaultLocale ? "/" : "/es/"}
      tabindex="0">{t.nav.dashboard}</a
    >
    <a
      class={`mobile-nav-link text-xl md:text-2xl font-bold py-4 px-3 rounded-xl transition-colors ${
        isActive("/banners/")
          ? "text-primary bg-primary/10"
          : "text-slate-300 hover:bg-white/5"
      }`}
      href={currentLocale === defaultLocale ? "/banners/" : "/es/banners/"}
      tabindex="0">{t.nav.currentBanners}</a
    >
    <a
      class={`mobile-nav-link text-xl md:text-2xl font-bold py-4 px-3 rounded-xl transition-colors ${
        isActive("/guides/")
          ? "text-primary bg-primary/10"
          : "text-slate-300 hover:bg-white/5"
      }`}
      href={currentLocale === defaultLocale ? "/guides/" : "/es/guides/"}
      tabindex="0">{t.nav.characterGuides}</a
    >
    <a
      class={`mobile-nav-link text-xl md:text-2xl font-bold py-4 px-3 rounded-xl transition-colors ${
        isActive("/releases/")
          ? "text-primary bg-primary/10"
          : "text-slate-300 hover:bg-white/5"
      }`}
      href={currentLocale === defaultLocale ? "/releases/" : "/es/releases/"}
      tabindex="0">{t.nav.releases}</a
    >
    <div class="mt-4 pt-4 border-t border-slate-800">
      <a
        class="mobile-nav-link text-xl font-bold py-4 px-3 rounded-xl text-slate-300 hover:bg-white/5 flex items-center gap-3 transition-colors"
        href={localizedHomeUrl}
        tabindex="0"
      >
        <span class="material-symbols-outlined" aria-hidden="true"
          >language</span
        >
        <span class="uppercase">{currentLocale}</span>
      </a>
    </div>
  </nav>
</div>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById(
      "mobile-menu-btn",
    ) as HTMLButtonElement | null;
    const closeBtn = document.getElementById(
      "mobile-close-btn",
    ) as HTMLButtonElement | null;
    const mobileMenu = document.getElementById(
      "mobile-menu",
    ) as HTMLElement | null;
    const backdrop = document.getElementById(
      "mobile-backdrop",
    ) as HTMLElement | null;

    if (!menuBtn || !mobileMenu || !backdrop) return;

    function getFocusable(): HTMLElement[] {
      return Array.from(
        mobileMenu!.querySelectorAll<HTMLElement>(
          "a[href], button:not([disabled])",
        ),
      );
    }

    let previousActiveElement: HTMLElement | null = null;

    const closeMenu = () => {
      mobileMenu.classList.remove("translate-x-0");

      mobileMenu.classList.add("translate-x-full");

      backdrop.classList.add("hidden");

      menuBtn.setAttribute("aria-expanded", "false");

      menuBtn.setAttribute("aria-label", "Open menu");

      menuBtn.focus();
      document.body.style.overflow = "";

      if (previousActiveElement) {
        previousActiveElement.focus();
        previousActiveElement = null;
      }
    };

    const openMenu = () => {
      previousActiveElement = document.activeElement as HTMLElement | null;

      backdrop.classList.remove("hidden");

      mobileMenu.classList.remove("translate-x-full");

      mobileMenu.classList.add("translate-x-0");

      menuBtn.setAttribute("aria-expanded", "true");

      menuBtn.setAttribute("aria-label", "Close menu");
      document.body.style.overflow = "hidden";
      const focusable = getFocusable();
      if (focusable.length > 0) {
        setTimeout(() => focusable[0].focus(), 100);
      }
    };

    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();

      const isOpen = mobileMenu.classList.contains("translate-x-0");
      if (isOpen) closeMenu();
      else openMenu();
    });

    if (closeBtn) closeBtn.addEventListener("click", closeMenu);

    backdrop.addEventListener("click", closeMenu);

    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        mobileMenu.classList.contains("translate-x-0")
      ) {
        closeMenu();
      }

      if (e.key === "Tab" && mobileMenu.classList.contains("translate-x-0")) {
        const focusable = getFocusable();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    window.addEventListener("popstate", () => {
      if (mobileMenu.classList.contains("translate-x-0")) closeMenu();
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
</script>

<style>
  .mobile-nav-link {
    opacity: 0;
    animation: fadeInUp 0.25s ease-out forwards;
  }

  .mobile-nav-link:nth-child(1) {
    animation-delay: 0.05s;
  }
  .mobile-nav-link:nth-child(2) {
    animation-delay: 0.08s;
  }
  .mobile-nav-link:nth-child(3) {
    animation-delay: 0.11s;
  }
  .mobile-nav-link:nth-child(4) {
    animation-delay: 0.14s;
  }
  .mobile-nav-link:nth-child(5) {
    animation-delay: 0.17s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
