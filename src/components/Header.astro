---
import {
  getLangFromUrl,
  useTranslations,
  getLocalizedUrl,
  defaultLocale,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath.startsWith(href);
};

const currentLocale = lang;
const targetLocale = currentLocale === defaultLocale ? "es" : defaultLocale;
const localizedHomeUrl = getLocalizedUrl(Astro.url, targetLocale);
---

<header
  class="flex items-center justify-between border-b border-white/[0.08] px-4 md:px-8 py-3.5 sticky top-0 bg-[#07080f]/85 backdrop-blur-xl z-50 transition-all shadow-[0_4px_24px_rgba(0,0,0,0.4)]"
  role="banner"
>
  <!-- Logo & Game HUD Branding -->
  <div class="flex items-center">
    <a href={currentLocale === defaultLocale ? "/" : "/es/"} class="group flex items-center gap-3">
      <div class="relative size-8 md:size-9 rounded-lg overflow-hidden p-0.5 ring-1 ring-white/15 bg-gradient-to-br from-indigo-500/20 to-purple-500/20 transition-transform group-hover:scale-105">
        <img
          src="/logo.webp"
          alt="Gacha Countdown Logo"
          class="w-full h-full object-cover rounded-md"
        />
        <div class="absolute inset-0 bg-indigo-500/10 opacity-0 group-hover:opacity-100 transition-opacity rounded-md pointer-events-none"></div>
      </div>

      <div class="flex flex-col">
        <span class="font-display text-sm md:text-base font-black tracking-wider text-white group-hover:text-indigo-300 transition-colors uppercase leading-none">
          Gacha Countdown
        </span>
        <span class="text-[9px] text-slate-500 font-mono tracking-widest uppercase mt-0.5 flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          LIVE RADAR
        </span>
      </div>
    </a>
  </div>

  <!-- Desktop Cockpit Navigation -->
  <nav class="hidden md:flex items-center gap-1.5 lg:gap-3" aria-label="Main navigation">
    <a
      class={`text-xs font-semibold uppercase tracking-wider px-3.5 py-2 rounded-lg transition-all flex items-center gap-2 ${
        isActive("/")
          ? "bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 shadow-[0_0_12px_rgba(99,102,241,0.2)] font-bold"
          : "text-slate-400 hover:text-white hover:bg-white/[0.04] border border-transparent"
      }`}
      href={currentLocale === defaultLocale ? "/" : "/es/"}
      aria-current={isActive("/") || isActive("/es/") ? "page" : undefined}
    >
      {isActive("/") && <span class="size-1.5 rounded-full bg-indigo-400 shadow-[0_0_8px_#818cf8]" aria-hidden="true"></span>}
      {t.nav.dashboard}
    </a>
    <a
      class={`text-xs font-semibold uppercase tracking-wider px-3.5 py-2 rounded-lg transition-all flex items-center gap-2 ${
        isActive("/banners/")
          ? "bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 shadow-[0_0_12px_rgba(99,102,241,0.2)] font-bold"
          : "text-slate-400 hover:text-white hover:bg-white/[0.04] border border-transparent"
      }`}
      href={currentLocale === defaultLocale ? "/banners/" : "/es/banners/"}
      aria-current={isActive("/banners/") || isActive("/es/banners/") ? "page" : undefined}
    >
      {isActive("/banners/") && <span class="size-1.5 rounded-full bg-indigo-400 shadow-[0_0_8px_#818cf8]" aria-hidden="true"></span>}
      {t.nav.currentBanners}
    </a>
    <a
      class={`text-xs font-semibold uppercase tracking-wider px-3.5 py-2 rounded-lg transition-all flex items-center gap-2 ${
        isActive("/guides/")
          ? "bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 shadow-[0_0_12px_rgba(99,102,241,0.2)] font-bold"
          : "text-slate-400 hover:text-white hover:bg-white/[0.04] border border-transparent"
      }`}
      href={currentLocale === defaultLocale ? "/guides/" : "/es/guides/"}
      aria-current={isActive("/guides/") || isActive("/es/guides/") ? "page" : undefined}
    >
      {isActive("/guides/") && <span class="size-1.5 rounded-full bg-indigo-400 shadow-[0_0_8px_#818cf8]" aria-hidden="true"></span>}
      {t.nav.characterGuides}
    </a>
    <a
      class={`text-xs font-semibold uppercase tracking-wider px-3.5 py-2 rounded-lg transition-all flex items-center gap-2 ${
        isActive("/releases/")
          ? "bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 shadow-[0_0_12px_rgba(99,102,241,0.2)] font-bold"
          : "text-slate-400 hover:text-white hover:bg-white/[0.04] border border-transparent"
      }`}
      href={currentLocale === defaultLocale ? "/releases/" : "/es/releases/"}
      aria-current={isActive("/releases/") || isActive("/es/releases/") ? "page" : undefined}
    >
      {isActive("/releases/") && <span class="size-1.5 rounded-full bg-indigo-400 shadow-[0_0_8px_#818cf8]" aria-hidden="true"></span>}
      {t.nav.releases}
    </a>

    <!-- Language Selector Pill -->
    <div class="ml-2 pl-2 border-l border-white/10 flex items-center">
      <a
        href={localizedHomeUrl}
        class="text-xs font-mono font-bold text-slate-400 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] px-3 py-1.5 rounded-lg border border-white/10 hover:border-indigo-400/40 transition-all flex items-center gap-1.5 shadow-sm"
        title={t.footer.language}
      >
        <span class="material-symbols-outlined text-sm text-indigo-400">language</span>
        <span class="uppercase tracking-wider">{currentLocale}</span>
      </a>
    </div>
  </nav>

  <!-- Mobile Menu Toggle Button -->
  <button
    id="mobile-menu-btn"
    class="md:hidden p-2 rounded-lg bg-white/[0.04] border border-white/10 text-slate-300 hover:text-white hover:border-indigo-500/40 transition-all min-w-[44px] min-h-[44px] flex items-center justify-center cursor-pointer"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
  </button>
</header>

<!-- Mobile Menu Backdrop -->
<div
  id="mobile-backdrop"
  class="md:hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-40 hidden transition-opacity"
  aria-hidden="true"
>
</div>

<!-- Mobile Menu Panel -->
<div
  id="mobile-menu"
  class="md:hidden fixed top-0 right-0 h-full w-[85vw] max-w-xs bg-[#090a14]/98 border-l border-white/10 backdrop-blur-2xl z-50 translate-x-full transition-transform duration-300 ease-out flex flex-col shadow-2xl"
  role="dialog"
  aria-label="Mobile navigation"
  aria-modal="true"
>
  <div class="flex items-center justify-between px-6 pt-5 pb-3 border-b border-white/5 safe-top">
    <div class="flex items-center gap-2">
      <div class="size-2 rounded-full bg-emerald-400 animate-pulse"></div>
      <span class="font-display text-xs font-bold text-slate-400 uppercase tracking-widest">
        SYSTEM NAV
      </span>
    </div>
    <button
      id="mobile-close-btn"
      class="p-2 text-slate-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors min-w-[40px] min-h-[40px] flex items-center justify-center cursor-pointer"
      aria-label="Close menu"
    >
      <span class="material-symbols-outlined text-2xl" aria-hidden="true">close</span>
    </button>
  </div>

  <nav
    class="flex flex-col px-4 py-4 gap-1.5 overflow-y-auto max-h-[calc(100vh-5rem)] flex-1"
    aria-label="Mobile"
  >
    <a
      class={`mobile-nav-link text-base font-bold py-3.5 px-4 rounded-xl transition-all flex items-center justify-between ${
        isActive("/")
          ? "text-indigo-300 bg-indigo-500/15 border border-indigo-500/30 font-bold"
          : "text-slate-300 hover:bg-white/5 border border-transparent"
      }`}
      href={currentLocale === defaultLocale ? "/" : "/es/"}
      tabindex="0"
    >
      <span>{t.nav.dashboard}</span>
      {isActive("/") && <span class="size-1.5 rounded-full bg-indigo-400 shadow-[0_0_8px_#818cf8]" aria-hidden="true"></span>}
    </a>
    <a
      class={`mobile-nav-link text-base font-bold py-3.5 px-4 rounded-xl transition-all flex items-center justify-between ${
        isActive("/banners/")
          ? "text-indigo-300 bg-indigo-500/15 border border-indigo-500/30 font-bold"
          : "text-slate-300 hover:bg-white/5 border border-transparent"
      }`}
      href={currentLocale === defaultLocale ? "/banners/" : "/es/banners/"}
      tabindex="0"
    >
      <span>{t.nav.currentBanners}</span>
      {isActive("/banners/") && <span class="size-1.5 rounded-full bg-indigo-400 shadow-[0_0_8px_#818cf8]" aria-hidden="true"></span>}
    </a>
    <a
      class={`mobile-nav-link text-base font-bold py-3.5 px-4 rounded-xl transition-all flex items-center justify-between ${
        isActive("/guides/")
          ? "text-indigo-300 bg-indigo-500/15 border border-indigo-500/30 font-bold"
          : "text-slate-300 hover:bg-white/5 border border-transparent"
      }`}
      href={currentLocale === defaultLocale ? "/guides/" : "/es/guides/"}
      tabindex="0"
    >
      <span>{t.nav.characterGuides}</span>
      {isActive("/guides/") && <span class="size-1.5 rounded-full bg-indigo-400 shadow-[0_0_8px_#818cf8]" aria-hidden="true"></span>}
    </a>
    <a
      class={`mobile-nav-link text-base font-bold py-3.5 px-4 rounded-xl transition-all flex items-center justify-between ${
        isActive("/releases/")
          ? "text-indigo-300 bg-indigo-500/15 border border-indigo-500/30 font-bold"
          : "text-slate-300 hover:bg-white/5 border border-transparent"
      }`}
      href={currentLocale === defaultLocale ? "/releases/" : "/es/releases/"}
      tabindex="0"
    >
      <span>{t.nav.releases}</span>
      {isActive("/releases/") && <span class="size-1.5 rounded-full bg-indigo-400 shadow-[0_0_8px_#818cf8]" aria-hidden="true"></span>}
    </a>

    <div class="mt-auto pt-6 border-t border-white/5">
      <a
        class="mobile-nav-link text-sm font-mono font-bold py-3 px-4 rounded-xl bg-white/[0.04] border border-white/10 text-slate-300 hover:bg-white/[0.08] flex items-center justify-between transition-colors"
        href={localizedHomeUrl}
        tabindex="0"
      >
        <span class="flex items-center gap-2">
          <span class="material-symbols-outlined text-indigo-400 text-lg" aria-hidden="true">language</span>
          <span>{t.footer.language}</span>
        </span>
        <span class="uppercase text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded border border-indigo-500/30">{currentLocale}</span>
      </a>
    </div>
  </nav>
</div>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById(
      "mobile-menu-btn",
    ) as HTMLButtonElement | null;
    const closeBtn = document.getElementById(
      "mobile-close-btn",
    ) as HTMLButtonElement | null;
    const mobileMenu = document.getElementById(
      "mobile-menu",
    ) as HTMLElement | null;
    const backdrop = document.getElementById(
      "mobile-backdrop",
    ) as HTMLElement | null;

    if (!menuBtn || !mobileMenu || !backdrop) return;

    function getFocusable(): HTMLElement[] {
      return Array.from(
        mobileMenu!.querySelectorAll<HTMLElement>(
          "a[href], button:not([disabled])",
        ),
      );
    }

    let previousActiveElement: HTMLElement | null = null;

    const closeMenu = () => {
      mobileMenu.classList.remove("translate-x-0");

      mobileMenu.classList.add("translate-x-full");

      backdrop.classList.add("hidden");

      menuBtn.setAttribute("aria-expanded", "false");

      menuBtn.setAttribute("aria-label", "Open menu");

      menuBtn.focus();
      document.body.style.overflow = "";

      if (previousActiveElement) {
        previousActiveElement.focus();
        previousActiveElement = null;
      }
    };

    const openMenu = () => {
      previousActiveElement = document.activeElement as HTMLElement | null;

      backdrop.classList.remove("hidden");

      mobileMenu.classList.remove("translate-x-full");

      mobileMenu.classList.add("translate-x-0");

      menuBtn.setAttribute("aria-expanded", "true");

      menuBtn.setAttribute("aria-label", "Close menu");
      document.body.style.overflow = "hidden";
      const focusable = getFocusable();
      if (focusable.length > 0) {
        setTimeout(() => focusable[0].focus(), 100);
      }
    };

    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();

      const isOpen = mobileMenu.classList.contains("translate-x-0");
      if (isOpen) closeMenu();
      else openMenu();
    });

    if (closeBtn) closeBtn.addEventListener("click", closeMenu);

    backdrop.addEventListener("click", closeMenu);

    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        mobileMenu.classList.contains("translate-x-0")
      ) {
        closeMenu();
      }

      if (e.key === "Tab" && mobileMenu.classList.contains("translate-x-0")) {
        const focusable = getFocusable();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    window.addEventListener("popstate", () => {
      if (mobileMenu.classList.contains("translate-x-0")) closeMenu();
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
</script>

<style>
  .mobile-nav-link {
    opacity: 0;
    animation: fadeInUp 0.25s ease-out forwards;
  }

  .mobile-nav-link:nth-child(1) {
    animation-delay: 0.05s;
  }
  .mobile-nav-link:nth-child(2) {
    animation-delay: 0.08s;
  }
  .mobile-nav-link:nth-child(3) {
    animation-delay: 0.11s;
  }
  .mobile-nav-link:nth-child(4) {
    animation-delay: 0.14s;
  }
  .mobile-nav-link:nth-child(5) {
    animation-delay: 0.17s;
  }
  .mobile-nav-link:nth-child(6) {
    animation-delay: 0.2s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
