---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { bannersData } from "../../data/banners";

interface Props {
  game: string;
  color?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { game, color = "var(--color-primary)" } = Astro.props;

const gameBanners = bannersData.find((g) => g.game === game);
const hasBanners = gameBanners && gameBanners.banners.length > 0;
---

{
  hasBanners && (
    <a
      href={lang === "en" ? `/banners/#${game}` : `/es/banners/#${game}`}
      class="block group max-w-2xl mx-auto"
      aria-label={t.banner.bannerAlert}
    >
      <div
        class="rounded-2xl p-3.5 sm:p-4 flex items-center gap-3.5 bg-[#090a16]/80 backdrop-blur-xl transition-all duration-300 border border-white/10 hover:border-(--alert-color)/40 shadow-lg hover:shadow-[0_0_24px_-8px_var(--alert-color)]"
        style={`--alert-color: ${color}`}
      >
        <div
          class="size-10 sm:size-11 rounded-xl flex items-center justify-center shrink-0 border border-white/10 transition-transform group-hover:scale-105"
          style={`background: ${color}20; box-shadow: 0 0 12px ${color}20;`}
        >
          <span
            class="material-symbols-outlined text-xl"
            style={`color: ${color}`}
            aria-hidden="true"
          >
            military_tech
          </span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-white text-xs sm:text-sm font-bold font-display uppercase tracking-wide leading-tight group-hover:text-(--alert-color) transition-colors">
            {t.banner.bannerAlert}
          </p>
          <p class="text-slate-400 text-[11px] sm:text-xs leading-tight mt-0.5 truncate">
            {t.banner.bannerAlertDesc}
          </p>
        </div>
        <div
          class="text-xs sm:text-sm font-mono font-bold flex items-center gap-1.5 group-hover:translate-x-1 transition-all shrink-0 px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/10 group-hover:border-(--alert-color)/40"
          style={`color: ${color}`}
        >
          <span>{t.banner.viewNow}</span>
          <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
        </div>
      </div>
    </a>
  )
}
