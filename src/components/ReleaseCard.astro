---
import { ReleaseCounter } from "./react/ReleaseCounter";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, imagen, fecha_salida, tema, href, alias } = Astro.props as {
  title: string;
  imagen: string;
  fecha_salida: string;
  tema: string;
  href: string;
  alias?: string;
};

const colorMap: Record<string, string> = {
  NTE: "#a78bfa",
  neverness: "#a78bfa",
};

const accentColor = (alias && colorMap[alias]) || tema;
---

<a
  href={`/releases${href}`}
  class="group relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-900 h-95 flex flex-col justify-end p-8 transition-all"
>
  <div
    class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
    style=`background-image: linear-gradient(180deg, rgba(10, 10, 12, 0.2) 0%, rgba(10, 10, 12, 0.95) 100%), url(${imagen});`
  >
  </div>
  <div
    class="absolute top-6 right-6 glass-panel px-3 py-1 rounded-full"
    style=`border: 1px solid ${accentColor};`
  >
    <span
      class="text-xs font-bold tracking-widest uppercase"
      style=`color: ${tema}`>{t.releaseCard.releaseDate}</span
    >
  </div>
  <div class="relative z-10">
    <div class="flex items-center gap-2 mb-2">
      <h3 class="text-2xl font-bold">{title}</h3>
      <div class="size-2 rounded-full bg-purple-500 animate-pulse"></div>
    </div>
    <p class="text-slate-400 text-sm mb-6">
      {t.releaseCard.daysUntil}
    </p>
    <ReleaseCounter
      client:only="react"
      fecha_salida={fecha_salida}
      labels={{
        days: t.counter.days,
        hours: t.counter.hours,
        minutes: t.counter.minutes,
        seconds: t.counter.seconds,
        finished: t.release.released,
      }}
    />
  </div>
  <div
    class="absolute bottom-0 left-0 h-1 transition-all w-0 group-hover:w-full"
    style=`background-color: ${accentColor}`
  >
  </div>
</a>
