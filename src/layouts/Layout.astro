---
import "../styles/global.css";
import "material-symbols/outlined.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import {
  absoluteUrl,
  buildAlternates,
  buildBreadcrumbs,
  DEFAULT_OG_IMAGE,
  getSiteUrl,
  normalizePath,
  resolveImage,
  robotsContent,
  SITE_NAME,
  type SeoLocale,
} from "../utils/seo";
import {
  buildBreadcrumbSchema,
  buildOrganizationSchema,
  buildWebSiteSchema,
} from "../utils/seo-schema";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  url?: string;
  type?: string;
  keywords?: string;
  author?: string;
  canonical?: string;
  lang?: string;
  noindex?: boolean;
  nofollow?: boolean;
  showBreadcrumbs?: boolean;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = (Astro.props.lang ?? lang) as SeoLocale;
const site = getSiteUrl(Astro.site);

const {
  title,
  description = t.meta.description,
  image = DEFAULT_OG_IMAGE,
  imageAlt = `${title} | ${SITE_NAME}`,
  url,
  type = "website",
  keywords = "",
  author = "Gacha Countdown Team",
  canonical,
  noindex = false,
  nofollow = false,
  showBreadcrumbs = true,
  publishedTime,
  modifiedTime,
} = Astro.props;

const rawPagePath = canonical ?? url;
const canonicalPath = rawPagePath
  ? normalizePath(new URL(rawPagePath, site).pathname)
  : normalizePath(Astro.url.pathname);
const pageUrl = rawPagePath
  ? new URL(normalizePath(new URL(rawPagePath, site).pathname), site).href
  : absoluteUrl(site, canonicalPath);
const alternates = buildAlternates(canonicalPath, site);
const pageImage = resolveImage(site, image);
const breadcrumbItems = buildBreadcrumbs(canonicalPath, locale, site);
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);
const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    buildWebSiteSchema(site),
    buildOrganizationSchema(site),
    ...(breadcrumbSchema && !noindex ? [breadcrumbSchema] : []),
  ],
};
const ogLocale = locale === "es" ? "es_ES" : "en_US";
const alternateLocale = locale === "es" ? "en_US" : "es_ES";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/logo.ico" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords.replace(/\s+/g, " ").trim()} />}
    <meta name="author" content={author} />
    <meta name="robots" content={robotsContent({ noindex, nofollow })} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={pageUrl} />
    {!noindex && (
      <>
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="es" href={alternates.es} />
        <link rel="alternate" hreflang="x-default" href={alternates["x-default"]} />
      </>
    )}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />
    )}
    {type === "article" && <meta property="article:author" content={author} />}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(globalSchema)}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Consent Mode v2 (advanced): gtag.js always loads.
         Default consent is denied only for EEA/GB (cookieless pings +
         GA4 modeling); every other region defaults to granted.
         The cookie banner updates the consent state afterwards.
         Monetag stays gated behind the "Accept" button. -->
    <script is:inline>
      (function () {
        var storedConsent = null;
        try {
          storedConsent = localStorage.getItem("cookie-consent");
        } catch (e) {}

        window.__gcConsent = storedConsent === "accepted";
        window.__mtLoaded = false;

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;

        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
          region: ["EEA", "GB"],
        });

        if (storedConsent === "accepted") {
          gtag("consent", "update", {
            ad_storage: "granted",
            ad_user_data: "granted",
            ad_personalization: "granted",
            analytics_storage: "granted",
          });
        } else if (storedConsent === "rejected") {
          gtag("consent", "update", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied",
          });
        }

        gtag("js", new Date());
        gtag("config", "G-DE7X8J5NY6");

        var ga = document.createElement("script");
        ga.async = true;
        ga.src = "https://www.googletagmanager.com/gtag/js?id=G-DE7X8J5NY6";
        document.head.appendChild(ga);

        // Monetag Multitag (consent-gated, idempotent).
        // Mirrors the snippet from the Monetag dashboard:
        // <script src="https://quge5.com/88/tag.min.js" data-zone="293766" async>
        // NOTE: inline scripts are raw text (no Astro interpolation), so the
        // URL/zone are hardcoded here. Keep them in sync with src/config/ads.ts.
        window.__mtLoadAds = function () {
          if (window.__mtLoaded) return;
          var tagSrc = "https://quge5.com/88/tag.min.js";
          var tagZone = "293766";
          if (!tagSrc || !tagZone) return;
          window.__mtLoaded = true;

          var s = document.createElement("script");
          s.async = true;
          s.src = tagSrc;
          s.setAttribute("data-zone", tagZone);
          s.setAttribute("data-cfasync", "false");
          document.head.appendChild(s);
          window.dispatchEvent(new CustomEvent("monetag:loaded"));
        };

        if (window.__gcConsent) {
          window.__mtLoadAds();
        }
      })();
    </script>

    <!-- Silence Chrome View Transitions' benign skip error surfaced by
         ClientRouter (astro finished promise rejects when the viewport
         resizes mid-transition). Navigation still completes normally. -->
    <script is:inline>
      window.addEventListener("unhandledrejection", function (event) {
        var reason = event.reason;
        if (
          reason &&
          reason.name === "InvalidStateError" &&
          String(reason.message).indexOf("Viewport size changed") !== -1
        ) {
          event.preventDefault();
        }
      });
    </script>

    <!-- Fix: Re-initialize astro-islands (React client:only components) after View Transitions swap.
         Monetag slots re-observe themselves via the "monetag:loaded" /
         "astro:page-load" events, so no ad reload is needed here. -->
    <script is:inline>
      document.addEventListener("astro:after-swap", () => {
        window.dispatchEvent(new CustomEvent("astro:react-remount"));

        const consented =
          localStorage.getItem("cookie-consent") === "accepted";
        window.__gcConsent = consented;
        if (!consented) return;

        if (typeof window.__mtLoadAds === "function") {
          window.__mtLoadAds();
        }
        window.dispatchEvent(new CustomEvent("monetag:page"));
      });
    </script>
  </head>

  <ClientRouter />

  <body
    class="bg-background-dark text-slate-100 min-h-dvh flex flex-col relative selection:bg-indigo-500/30 selection:text-indigo-200"
  >
    <!-- Gamer Background Atmosphere -->
    <div
      class="fixed inset-0 cyber-grid opacity-35 pointer-events-none z-0"
      aria-hidden="true"
    >
    </div>
    <div
      class="fixed inset-0 cyber-radial-glow pointer-events-none z-0"
      aria-hidden="true"
    >
    </div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-3 focus:bg-primary focus:text-white focus:rounded-lg focus:font-bold focus:min-w-[48px] focus:min-h-[48px]"
    >
      Skip to main content
    </a>
    <div class="text-white relative z-10 flex h-full grow flex-col">
      <Header />
      {showBreadcrumbs && breadcrumbItems.length > 1 && <Breadcrumbs items={breadcrumbItems} locale={locale} />}
      <slot />
      <Footer />
    </div>
    <CookieBanner />
  </body>
</html>
