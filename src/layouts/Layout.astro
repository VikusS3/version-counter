---
import "../styles/global.css";
import "material-symbols/outlined.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import {
  absoluteUrl,
  buildAlternates,
  buildBreadcrumbs,
  DEFAULT_OG_IMAGE,
  getSiteUrl,
  normalizePath,
  resolveImage,
  robotsContent,
  SITE_NAME,
  type SeoLocale,
} from "../utils/seo";
import {
  buildBreadcrumbSchema,
  buildOrganizationSchema,
  buildWebSiteSchema,
} from "../utils/seo-schema";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  url?: string;
  type?: string;
  keywords?: string;
  author?: string;
  canonical?: string;
  lang?: string;
  noindex?: boolean;
  nofollow?: boolean;
  showBreadcrumbs?: boolean;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = (Astro.props.lang ?? lang) as SeoLocale;
const site = getSiteUrl(Astro.site);

const {
  title,
  description = t.meta.description,
  image = DEFAULT_OG_IMAGE,
  imageAlt = `${title} | ${SITE_NAME}`,
  url,
  type = "website",
  keywords = "",
  author = "Gacha Countdown Team",
  canonical,
  noindex = false,
  nofollow = false,
  showBreadcrumbs = true,
  publishedTime,
  modifiedTime,
} = Astro.props;

const rawPagePath = canonical ?? url;
const canonicalPath = rawPagePath
  ? normalizePath(new URL(rawPagePath, site).pathname)
  : normalizePath(Astro.url.pathname);
const pageUrl = rawPagePath
  ? new URL(normalizePath(new URL(rawPagePath, site).pathname), site).href
  : absoluteUrl(site, canonicalPath);
const alternates = buildAlternates(canonicalPath, site);
const pageImage = resolveImage(site, image);
const breadcrumbItems = buildBreadcrumbs(canonicalPath, locale, site);
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);
const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    buildWebSiteSchema(site),
    buildOrganizationSchema(site),
    ...(breadcrumbSchema && !noindex ? [breadcrumbSchema] : []),
  ],
};
const ogLocale = locale === "es" ? "es_ES" : "en_US";
const alternateLocale = locale === "es" ? "en_US" : "es_ES";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/logo.ico" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords.replace(/\s+/g, " ").trim()} />}
    <meta name="author" content={author} />
    <meta name="robots" content={robotsContent({ noindex, nofollow })} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={pageUrl} />
    {!noindex && (
      <>
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="es" href={alternates.es} />
        <link rel="alternate" hreflang="x-default" href={alternates["x-default"]} />
      </>
    )}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />
    )}
    {type === "article" && <meta property="article:author" content={author} />}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(globalSchema)}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Consent-gated third-party scripts (AdSense + Google Analytics).
         Loaded only after the user accepts the cookie consent banner. -->
    <script is:inline>
      (function () {
        if (typeof localStorage === "undefined") return;

        window.__gcConsent =
          localStorage.getItem("cookie-consent") === "accepted";
        window.__gcAdLoaded = false;
        window.__gcAnalyticsLoaded = false;

        window.__gcLoadAds = function () {
          if (window.__gcAdLoaded) return;
          window.__gcAdLoaded = true;

          var s = document.createElement("script");
          s.async = true;
          s.src =
            "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1296222480269245";
          s.crossOrigin = "anonymous";
          document.head.appendChild(s);
        };

        window.__gcLoadAnalytics = function () {
          if (window.__gcAnalyticsLoaded) return;
          window.__gcAnalyticsLoaded = true;

          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag("consent", "default", {
            ad_storage: "granted",
            ad_user_data: "granted",
            ad_personalization: "granted",
            analytics_storage: "granted",
          });
          gtag("js", new Date());
          gtag("config", "G-DE7X8J5NY6");

          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-DE7X8J5NY6";
          document.head.appendChild(s);
        };

        if (window.__gcConsent) {
          window.__gcLoadAnalytics();
          window.__gcLoadAds();
        }
      })();
    </script>

    <!-- Fix: Re-initialize astro-islands (React client:only components) after View Transitions swap -->
    <script is:inline>
      document.addEventListener("astro:after-swap", () => {
        window.dispatchEvent(new CustomEvent("astro:react-remount"));

        const consented =
          localStorage.getItem("cookie-consent") === "accepted";
        window.__gcConsent = consented;
        if (!consented) return;

        reloadAdsense();
      });

      function reloadAdsense() {
        const adSlot = document.querySelector("ins.adsbygoogle");
        const adScript = document.querySelector(
          'script[src*="adsbygoogle.js"]',
        );
        if (!adSlot || !adScript) return;

        document
          .querySelectorAll('script[src*="adsbygoogle.js"]')
          .forEach((s) => s.remove());

        const newScript = document.createElement("script");
        newScript.async = true;
        newScript.src = adScript.src;
        newScript.crossOrigin = "anonymous";
        document.head.appendChild(newScript);

        (window.adsbygoogle = window.adsbygoogle || []).push({});
      }
    </script>
  </head>

  <ClientRouter />

  <body
    class="bg-background-dark text-slate-100 min-h-dvh flex flex-col relative selection:bg-indigo-500/30 selection:text-indigo-200"
  >
    <!-- Gamer Background Atmosphere -->
    <div
      class="fixed inset-0 cyber-grid opacity-35 pointer-events-none z-0"
      aria-hidden="true"
    >
    </div>
    <div
      class="fixed inset-0 cyber-radial-glow pointer-events-none z-0"
      aria-hidden="true"
    >
    </div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-3 focus:bg-primary focus:text-white focus:rounded-lg focus:font-bold focus:min-w-[48px] focus:min-h-[48px]"
    >
      Skip to main content
    </a>
    <div class="text-white relative z-10 flex h-full grow flex-col">
      <Header />
      {showBreadcrumbs && breadcrumbItems.length > 1 && <Breadcrumbs items={breadcrumbItems} locale={locale} />}
      <slot />
      <Footer />
    </div>
    <CookieBanner />
  </body>
</html>
